---
import Base from '../layouts/Base.astro';
import { query, type BookingRow } from '../lib/db';
import { checkAdminAuth, unauthorized } from '../lib/auth';
import { getPackage, getStudio, PACKAGES as BOOKABLE } from '../config/booking';
import { getCard } from '../data/packages';
import { travelLabel, REQUIRED_CONSENTS, type ConsentRow } from '../lib/training';

const siteBase = (import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin).replace(/\/$/, '');
const shareLinks = BOOKABLE.map((p) => ({
  slug: p.slug,
  title: p.title,
  image: getCard(p.slug)?.image,
  url: `${siteBase}/book/${p.slug}`,
}));

export const prerender = false;

if (!checkAdminAuth(Astro.request)) {
  return unauthorized();
}

const bookings = (
  await query<BookingRow>(
    `SELECT * FROM bookings
     WHERE status != 'expired' AND date >= CURRENT_DATE - INTERVAL '7 days'
     ORDER BY date ASC, start_time ASC
     LIMIT 200`
  )
).rows;

const blocked = (
  await query<{ id: number; date: string; start_time: string | null; end_time: string | null; reason: string | null }>(
    `SELECT * FROM blocked_slots WHERE date >= CURRENT_DATE ORDER BY date ASC LIMIT 100`
  )
).rows;

// Safeguarding records for the youth training programme. Newest first.
const consents = (
  await query<ConsentRow>(
    `SELECT * FROM training_consents ORDER BY created_at DESC LIMIT 200`
  )
).rows;

// DATE columns come back as 'YYYY-MM-DD' strings (see lib/db), but TIMESTAMPTZ
// still arrives as a Date, so it needs formatting rather than slicing.
const ts = (v: string | Date) =>
  new Date(v).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const fmt = (p: number) => `£${(p / 100).toFixed(2)}`;
const d = (s: string) => String(s).slice(0, 10);
const t = (s: string | null) => (s ? String(s).slice(0, 5) : '');

const statusLabel: Record<string, string> = {
  pending_payment: '⏳ pending payment',
  deposit_paid: '💰 deposit paid',
  paid_in_full: '✅ paid in full',
  cancelled: '✕ cancelled',
};

const where = (b: BookingRow) =>
  b.location_type === 'on_location'
    ? `On location, ${b.address || 'TBC'}`
    : (getStudio(b.studio_id)?.name ?? 'CHACE STUDIOS');

const pkgTitle = (b: BookingRow) => getPackage(b.package_slug)?.title ?? b.package_slug;

// Agenda: confirmed, still-upcoming bookings grouped by day.
const todayIso = new Date().toISOString().slice(0, 10);
const agendaDays = [
  ...bookings
    .filter((b) => ['deposit_paid', 'paid_in_full'].includes(b.status) && d(b.date) >= todayIso)
    .reduce((map, b) => {
      const key = d(b.date);
      (map.get(key) ?? map.set(key, []).get(key)!).push(b);
      return map;
    }, new Map<string, BookingRow[]>())
    .entries(),
].sort(([a], [b]) => a.localeCompare(b));

const dayName = (iso: string) => {
  const date = new Date(`${iso}T12:00:00`);
  const label = date.toLocaleDateString('en-GB', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
  });
  const days = Math.round((date.getTime() - new Date(`${todayIso}T12:00:00`).getTime()) / 86400000);
  if (days === 0) return `${label} · today`;
  if (days === 1) return `${label} · tomorrow`;
  return `${label} · in ${days} days`;
};

const mins = (b: BookingRow) => {
  const [sh, sm] = t(b.start_time).split(':').map(Number);
  const [eh, em] = t(b.end_time).split(':').map(Number);
  return eh * 60 + em - (sh * 60 + sm);
};
---

<Base title="Admin | CHACE STUDIOS" description="Admin">
  <main class="ad">
    <div class="ad__head">
      <h1 class="display ad__title">Bookings admin</h1>
      <a href="/admin/boards" class="ad__btn ad__btn--board">Moodboards</a>
    </div>

    <section class="ad__section">
      <h2 class="display ad__h2">Schedule</h2>
      {agendaDays.length === 0 ? (
        <p class="ad__empty">Nothing confirmed coming up.</p>
      ) : (
        <div class="ad__agenda">
          {agendaDays.map(([iso, items]) => (
            <div class="ad__day">
              <div class="ad__day-head">
                <span class="ad__day-name">{dayName(iso)}</span>
                <span class="ad__day-count">{items.length} {items.length === 1 ? 'shoot' : 'shoots'}</span>
              </div>
              {items.map((b) => (
                <div class="ad__slot">
                  <span class="ad__slot-time">{t(b.start_time)}–{t(b.end_time)}</span>
                  <span class="ad__slot-body">
                    <strong>{pkgTitle(b)}</strong> · {b.tier_label}<br />
                    <span class="ad__sub">
                      {b.name} · {mins(b)} min · {where(b)}
                      {b.balance_pence > 0 && <span class="ad__due"> · {fmt(b.balance_pence)} due</span>}
                    </span>
                  </span>
                  <span class="ad__mono ad__slot-ref">{b.ref}</span>
                </div>
              ))}
            </div>
          ))}
        </div>
      )}
    </section>

    <section class="ad__section">
      <h2 class="display ad__h2">All bookings</h2>
      {bookings.length === 0 ? (
        <p class="ad__empty">No bookings yet.</p>
      ) : (
        <div class="ad__scroll">
          <table class="ad__table">
            <thead>
              <tr>
                <th>Ref</th><th>Name</th><th>Package</th><th>Date / time</th><th>Where</th>
                <th>Paid</th><th>Balance</th><th>Status</th><th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {bookings.map((b) => (
                <tr class:list={{ 'ad__row--conflict': (b.notes ?? '').includes('[CONFLICT') }}>
                  <td class="ad__mono">{b.ref}</td>
                  <td>
                    {b.name}<br />
                    <span class="ad__sub">{b.email}{b.phone ? ` · ${b.phone}` : ''}</span>
                  </td>
                  <td>
                    {pkgTitle(b)}<br />
                    <span class="ad__sub">{b.tier_label}{b.promo_code ? ` · promo ${b.promo_code}` : ''}</span>
                  </td>
                  <td class="ad__mono">{d(b.date)} {t(b.start_time)}–{t(b.end_time)}</td>
                  <td><span class="ad__sub">{where(b)}</span></td>
                  <td class="ad__mono">{fmt(b.paid_pence)}</td>
                  <td class="ad__mono">{fmt(b.balance_pence)}</td>
                  <td>
                    {statusLabel[b.status] ?? b.status}
                    {(b.notes ?? '').includes('[CONFLICT') && <span class="ad__flag">CONFLICT</span>}
                  </td>
                  <td class="ad__actions">
                    {b.status === 'deposit_paid' && b.balance_pence > 0 && (
                      <form method="POST" action="/api/admin/collect-balance">
                        <input type="hidden" name="booking_id" value={b.id} />
                        <button type="submit" class="ad__btn">Collect balance</button>
                      </form>
                    )}
                    <form method="POST" action="/api/admin/boards/create">
                      <input type="hidden" name="client_name" value={b.name} />
                      <input type="hidden" name="title" value={`${b.name}, ${pkgTitle(b)}`} />
                      <button type="submit" class="ad__btn ad__btn--board">Moodboard</button>
                    </form>
                    {['deposit_paid', 'paid_in_full'].includes(b.status) && (
                      <form method="POST" action="/api/admin/resend-notification">
                        <input type="hidden" name="booking_id" value={b.id} />
                        <button type="submit" class="ad__btn">Resend emails</button>
                      </form>
                    )}
                    {b.balance_session_url && (
                      <button type="button" class="ad__btn ad__btn--copy" data-copy={b.balance_session_url}>
                        Copy pay link
                      </button>
                    )}
                    {['pending_payment', 'deposit_paid', 'paid_in_full'].includes(b.status) && (
                      <form method="POST" action="/api/admin/cancel" onsubmit="return confirm('Cancel this booking? (Refunds are manual, in Stripe.)')">
                        <input type="hidden" name="id" value={b.id} />
                        <button type="submit" class="ad__btn ad__btn--danger">Cancel</button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <section class="ad__section">
      <h2 class="display ad__h2">Shareable booking links</h2>
      <p class="ad__hint">
        One package per page, form locked to it. Personalise before sending by adding
        <code>?for=Coach%20Samira</code> and/or <code>&amp;note=Your%20message</code>.
      </p>
      <div class="ad__links">
        {shareLinks.map((l) => (
          <div class="ad__link-card">
            {l.image && <img class="ad__link-img" src={l.image} alt="" width="56" height="56" loading="lazy" />}
            <div class="ad__link-body">
              <span class="ad__link-title">{l.title}</span>
              <a class="ad__link-url" href={`/book/${l.slug}`} target="_blank" rel="noopener">/book/{l.slug} ↗</a>
            </div>
            <button type="button" class="ad__btn ad__btn--copy" data-copy={l.url}>Copy link</button>
          </div>
        ))}
      </div>
    </section>

    <section class="ad__section">
      <h2 class="display ad__h2">Blocked dates &amp; times</h2>
      <form method="POST" action="/api/admin/block" class="ad__blockform">
        <label>Date <input type="date" name="date" required /></label>
        <label>From <input type="time" name="start_time" /></label>
        <label>To <input type="time" name="end_time" /></label>
        <label>Reason <input type="text" name="reason" placeholder="e.g. holiday" /></label>
        <button type="submit" class="ad__btn">Block</button>
        <span class="ad__sub">Leave times empty to block the whole day.</span>
      </form>

      {blocked.length > 0 && (
        <div class="ad__scroll">
        <table class="ad__table ad__table--compact">
          <tbody>
            {blocked.map((bl) => (
              <tr>
                <td class="ad__mono">{d(bl.date)}</td>
                <td class="ad__mono">{bl.start_time ? `${t(bl.start_time)}–${t(bl.end_time)}` : 'whole day'}</td>
                <td>{bl.reason ?? ''}</td>
                <td>
                  <form method="POST" action="/api/admin/unblock">
                    <input type="hidden" name="id" value={bl.id} />
                    <button type="submit" class="ad__btn">Unblock</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
      )}
    </section>

    <section class="ad__section">
      <h2 class="display ad__h2">Training consents</h2>
      {consents.length === 0 ? (
        <p class="ad__empty">No consent forms yet. The form is at <a class="ad__link-inline" href="/training/consent">/training/consent</a>.</p>
      ) : (
        <>
          <p class="ad__consent-summary">
            {consents.length} {consents.length === 1 ? 'record' : 'records'} ·
            {' '}{consents.filter((c) => c.consent_travel).length} consented to travel beyond 5 miles ·
            {' '}{consents.filter((c) => c.consent_sharing).length} consented to public sharing
          </p>
          <div class="ad__consents">
            {consents.map((c) => (
              <details class="ad__consent">
                <summary class="ad__consent-head">
                  <span class="ad__consent-name">{c.student_name}</span>
                  <span class="ad__consent-tags">
                    <span class:list={['ad__tag', c.consent_travel ? 'ad__tag--yes' : 'ad__tag--no']}>
                      Travel {c.consent_travel ? 'yes' : 'no'}
                    </span>
                    <span class:list={['ad__tag', c.consent_filming ? 'ad__tag--yes' : 'ad__tag--no']}>
                      Filming {c.consent_filming ? 'yes' : 'no'}
                    </span>
                    <span class:list={['ad__tag', c.consent_sharing ? 'ad__tag--yes' : 'ad__tag--no']}>
                      Sharing {c.consent_sharing ? 'yes' : 'no'}
                    </span>
                  </span>
                  <span class="ad__mono ad__consent-date">{ts(c.created_at)}</span>
                </summary>

                <div class="ad__consent-body">
                  <dl class="ad__dl">
                    <dt>Date of birth</dt><dd>{d(c.student_dob)}</dd>
                    <dt>School or college</dt><dd>{c.student_school || 'Not given'}</dd>
                    <dt>Medical / needs</dt><dd class="ad__pre">{c.medical_notes || 'None declared'}</dd>
                    <dt>Parent or guardian</dt><dd>{c.parent_name} ({c.parent_relationship})</dd>
                    <dt>Mobile</dt><dd><a class="ad__link-inline" href={`tel:${c.parent_phone}`}>{c.parent_phone}</a></dd>
                    <dt>Email</dt><dd><a class="ad__link-inline" href={`mailto:${c.parent_email}`}>{c.parent_email}</a></dd>
                    <dt>Home address</dt><dd class="ad__pre">{c.parent_address}</dd>
                    <dt>Emergency contact</dt>
                    <dd>
                      {c.emergency_name} ({c.emergency_relationship})<br />
                      <a class="ad__link-inline" href={`tel:${c.emergency_phone}`}>{c.emergency_phone}</a>
                    </dd>
                    <dt>Getting to the studio</dt><dd>{travelLabel(c)}</dd>
                    <dt>Signed</dt><dd>{c.signature_name} on {d(c.signed_date)}</dd>
                    <dt>Submitted from</dt><dd class="ad__mono">{c.ip ?? 'unknown'}</dd>
                  </dl>

                  <div class="ad__consent-decls">
                    <span class="ad__consent-decls-head">
                      All {REQUIRED_CONSENTS.length} required declarations ticked
                    </span>
                    <span class="ad__sub">
                      Guardian · Participation · Free and unpaid · Equipment risk · Details accurate · Right to withdraw
                    </span>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </>
      )}
    </section>
  </main>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        const prev = btn.textContent;
        btn.textContent = 'Copied ✓';
        setTimeout(() => (btn.textContent = prev), 1500);
      });
    });
  </script>

  <style>
    .ad {
      padding: 48px var(--pad) 96px;
    }
    .ad__head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 40px;
    }
    .ad__title {
      font-size: clamp(28px, 4vw, 40px);
      letter-spacing: -0.04em;
      margin: 0;
    }
    .ad__h2 {
      font-size: 18px;
      letter-spacing: -0.02em;
      margin: 0 0 18px;
    }
    .ad__section {
      margin-bottom: 56px;
    }
    .ad__empty {
      color: var(--text-50);
    }
    .ad__scroll {
      overflow-x: auto;
    }
    .ad__table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    .ad__table th {
      text-align: left;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--muted);
      padding: 8px 12px;
      border-bottom: 1px solid var(--line-strong);
    }
    .ad__table td {
      padding: 12px;
      border-bottom: 1px solid var(--line);
      vertical-align: top;
    }
    .ad__row--conflict td {
      background: rgba(255, 25, 9, 0.08);
    }
    .ad__mono {
      font-family: var(--font-mono);
      font-size: 12px;
      white-space: nowrap;
    }
    .ad__sub {
      color: var(--text-50);
      font-size: 12px;
    }
    .ad__flag {
      display: inline-block;
      margin-left: 6px;
      padding: 1px 8px;
      background: var(--red);
      color: var(--white);
      font-family: var(--font-mono);
      font-size: 10px;
      border-radius: 9999px;
    }
    .ad__actions {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .ad__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: var(--tap);
      padding: 8px 14px;
      border: 1px solid var(--line-strong);
      border-radius: 6px;
      background: none;
      color: var(--white);
      font-family: var(--font-body);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      cursor: pointer;
      white-space: nowrap;
    }
    .ad__btn:hover {
      border-color: var(--white);
    }
    .ad__btn--danger:hover {
      border-color: var(--red);
      color: var(--red);
    }
    .ad__btn--copy,
    .ad__btn--board {
      border-color: var(--orange);
    }
    /* ---- Shareable links ---- */
    .ad__hint {
      font-size: 12.5px;
      line-height: 20px;
      color: var(--text-50);
      margin: -8px 0 18px;
    }
    .ad__hint code {
      font-family: var(--font-mono);
      font-size: 11.5px;
      color: var(--orange);
    }
    .ad__links {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
      gap: 10px;
    }
    .ad__link-card {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: 10px;
    }
    .ad__link-img {
      width: 44px;
      height: 44px;
      border-radius: 8px;
      object-fit: cover;
      flex: none;
    }
    .ad__link-body {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
      flex: 1;
    }
    .ad__link-title {
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 12.5px;
      line-height: 17px;
    }
    .ad__link-url {
      display: flex;
      align-items: center;
      min-height: var(--tap);
      min-width: 0;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .ad__link-url:hover {
      color: var(--white);
    }

    /* ---- Agenda ---- */
    .ad__agenda {
      display: flex;
      flex-direction: column;
      gap: 22px;
    }
    .ad__day {
      border: 1px solid var(--line);
      border-radius: 12px;
      overflow: hidden;
    }
    .ad__day-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 16px;
      background: rgba(255, 255, 255, 0.04);
      border-bottom: 1px solid var(--line);
    }
    .ad__day-name {
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }
    .ad__day-count {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--muted);
    }
    .ad__slot {
      display: grid;
      grid-template-columns: 118px 1fr auto;
      gap: 14px;
      align-items: start;
      padding: 13px 16px;
      border-bottom: 1px solid var(--line);
      font-size: 13.5px;
    }
    .ad__slot:last-child {
      border-bottom: 0;
    }
    .ad__slot-time {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--orange);
      white-space: nowrap;
      padding-top: 1px;
    }
    .ad__slot-body {
      line-height: 20px;
    }
    .ad__slot-ref {
      color: var(--muted);
    }
    .ad__due {
      color: var(--orange);
    }
    @media (max-width: 640px) {
      .ad__slot {
        grid-template-columns: 1fr;
        gap: 4px;
      }
      .ad__slot-ref {
        font-size: 11px;
      }
    }

    .ad__blockform {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: 12px;
      margin-bottom: 20px;
    }
    .ad__blockform label {
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--muted);
    }
    .ad__blockform input {
      min-height: var(--tap);
      padding: 8px 10px;
      background: var(--card);
      border: 1px solid var(--line-strong);
      border-radius: 6px;
      color: var(--white);
      color-scheme: dark;
      font-family: var(--font-body);
      font-size: 16px;
    }

    .ad__consent-summary {
      margin: -6px 0 16px;
      color: var(--text-50);
      font-size: 13px;
    }
    .ad__consents {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .ad__consent {
      border: 1px solid var(--line-strong);
      border-radius: 10px;
      background: var(--card);
    }
    .ad__consent-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 12px;
      min-height: var(--tap);
      padding: 10px 14px;
      cursor: pointer;
      list-style: none;
    }
    .ad__consent-head::-webkit-details-marker {
      display: none;
    }
    .ad__consent-head::before {
      content: '▸';
      color: var(--muted);
      font-size: 11px;
    }
    .ad__consent[open] .ad__consent-head::before {
      content: '▾';
    }
    .ad__consent-name {
      font-weight: 700;
      font-size: 14px;
      margin-right: auto;
    }
    .ad__consent-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .ad__tag {
      padding: 3px 9px;
      border-radius: 9999px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.6px;
      white-space: nowrap;
    }
    .ad__tag--yes {
      background: rgba(255, 166, 0, 0.16);
      color: var(--orange);
    }
    .ad__tag--no {
      background: rgba(255, 255, 255, 0.07);
      color: var(--text-50);
    }
    .ad__consent-date {
      font-size: 11px;
      color: var(--muted);
    }
    .ad__consent-body {
      padding: 4px 14px 16px;
      border-top: 1px solid var(--line);
    }
    .ad__dl {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2px 16px;
      margin: 14px 0 0;
    }
    .ad__dl dt {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      color: var(--muted);
      margin-top: 10px;
    }
    .ad__dl dd {
      margin: 0;
      font-size: 13.5px;
      line-height: 20px;
      color: var(--white);
      overflow-wrap: anywhere;
    }
    .ad__pre {
      white-space: pre-wrap;
    }
