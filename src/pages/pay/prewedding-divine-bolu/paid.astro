---
// Receipt landing page after a settled invoice is paid.
export const prerender = false;

import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { query } from '../../../lib/db';
import { getInvoice, money, longDate } from '../../../config/invoices';
import { EMAIL } from '../../../data/portfolio';

const invoice = getInvoice('prewedding-divine-bolu')!;
const ref = (Astro.url.searchParams.get('ref') ?? '').trim().slice(0, 40);

// The invoice row exists from the moment payment was started, so this page
// never depends on the webhook having landed yet.
let payerName = '';
if (ref) {
  const { rows } = await query<{ payer_name: string | null }>(
    `SELECT payer_name FROM invoices WHERE ref = $1 AND slug = $2`,
    [ref, invoice.slug]
  );
  payerName = (rows[0]?.payer_name ?? '').split(' ')[0] ?? '';
}
---

<Base
  title={`Paid, ${invoice.title} | CHACE STUDIOS`}
  description="Your payment has been received."
  ogImage={invoice.ogImage}
  robots="noindex, nofollow"
>
  <Header />

  <main class="pd">
    <section class="pd-hero">
      <p class="eyebrow pd-hero__eyebrow">Payment received</p>
      <h1 class="display pd-hero__title">
        {payerName ? `Thank you, ${payerName}.` : 'Thank you.'}
      </h1>
      <p class="pd-hero__lede">
        Your pre-wedding session is paid in full. Nothing further is due.
      </p>
      {ref && <p class="pd-ref">Reference <strong>{ref}</strong></p>}
    </section>

    <section class="pd-body sec-light">
      <div class="pd-inner">
        <div class="pd-note">
          Your receipt is on its way to the email address you paid with. If it has not
          arrived in a few minutes, check your spam folder.
        </div>

        <dl class="pd-summary">
          <div class="pd-row"><dt>Session</dt><dd>{invoice.sessionLabel}</dd></div>
          <div class="pd-row"><dt>Shot on</dt><dd>{longDate(invoice.sessionDate)}</dd></div>
          <div class="pd-row"><dt>Client</dt><dd>{invoice.clientName}</dd></div>
          <div class="pd-row"><dt>Paid</dt><dd><strong>{money(invoice.amountPence)}</strong>, in full</dd></div>
        </dl>

        <p class="pd-contact">
          Any questions, email <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .pd-hero {
    background: var(--bg);
    padding: 48px max(var(--pad), var(--safe-l)) 54px max(var(--pad), var(--safe-r));
    border-bottom: 1px solid var(--line);
  }
  .pd-hero__eyebrow {
    margin: 0 0 14px;
  }
  .pd-hero__title {
    font-size: clamp(34px, 10vw, 58px);
    line-height: 1;
    letter-spacing: -1.8px;
    margin: 0 0 14px;
  }
  .pd-hero__lede {
    margin: 0;
    max-width: 44ch;
    font-size: 15px;
    line-height: 25px;
    color: var(--text-70);
  }
  .pd-ref {
    margin: 18px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-50);
  }
  .pd-ref strong {
    color: var(--orange);
  }

  .pd-body {
    padding-top: 36px;
    padding-bottom: 56px;
  }
  .pd-inner {
    max-width: 520px;
    margin: 0 auto;
  }

  .pd-note {
    padding: 16px 18px;
    margin-bottom: 28px;
    border-radius: 12px;
    background: rgba(255, 166, 0, 0.1);
    border-left: 3px solid var(--orange);
    font-size: 14.5px;
    line-height: 22px;
    color: var(--ink);
  }

  .pd-summary {
    margin: 0 0 24px;
    padding: 0;
  }
  .pd-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    padding: 13px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.09);
  }
  .pd-row dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--ink-50);
  }
  .pd-row dd {
    margin: 0;
    font-size: 15px;
    line-height: 23px;
    color: var(--ink);
    text-align: right;
  }

  .pd-contact {
    margin: 0;
    font-size: 14.5px;
    line-height: 23px;
    color: var(--ink-60);
  }
  .pd-contact a {
    color: var(--ink);
    text-decoration: underline;
  }

  @media (min-width: 720px) {
    .pd-hero {
      padding-top: 72px;
      padding-bottom: 78px;
    }
    .pd-body {
      padding-top: 52px;
      padding-bottom: 84px;
    }
  }
</style>
