---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getBoard, getBoardItems } from '../../lib/boards';
import { images } from '../../data/portfolio';
import { configuredProviders } from '../api/images/[provider]';

const slug = String(Astro.params.slug ?? '');
const board = await getBoard(slug);
if (!board) return Astro.redirect('/', 302);

const items = await getBoardItems(board.id);
const NOTE_COLOURS = ['#FFA600', '#FF1909', '#F5F1E8', '#0a0a0a'];

// The studio's own frames, ready to be dragged onto any board.
const PORTFOLIO = [
  { id: 'portraits', label: 'Portraits' },
  { id: 'headshots', label: 'Headshots' },
  { id: 'events', label: 'Events' },
  { id: 'weddings', label: 'Weddings' },
  { id: 'pre-wedding', label: 'Pre-Wedding' },
  { id: 'family', label: 'Family' },
  { id: 'baby-shoots', label: 'Kids' },
  { id: 'graduation', label: 'Graduation' },
  { id: 'fashion', label: 'Fashion' },
  { id: 'bridal-shower', label: 'Bridal' },
].map((c) => ({ ...c, srcs: images(c.id) }));

const PORTFOLIO_FLAT = PORTFOLIO.flatMap((c) => c.srcs.map((src) => ({ src, category: c.id })));

// A provider with no key configured is hidden rather than shown broken.
// A capped sample for the atmosphere layer. Small on purpose: this is
// background texture, not a gallery.
const BACKDROP = [
  ...images('portraits', 5),
  ...images('weddings', 3),
  ...images('fashion', 3),
  ...images('events', 3),
];

const STOCK = configuredProviders();
const PRESETS = [
  'Weddings', 'Portraits', 'Maternity', 'Graduation', 'Studio lighting',
  'Editorial', 'Colour palettes', 'Poses', 'Set design',
];
---

<Base
  title={`${board.title ?? board.client_name} | CHACE STUDIOS moodboard`}
  description="Private moodboard"
  robots="noindex, nofollow"
>
  <div class="bd" data-slug={board.slug}>
    <header class="bd-bar">
      <div class="bd-bar__left">
        <span class="bd-logo display">CHACE</span>
        <span class="bd-client">{board.title ?? board.client_name}</span>
      </div>
      <div class="bd-bar__right">
        <button type="button" class="bd-tool" data-drawer-toggle aria-expanded="false" title="My portfolio">
          Portfolio
        </button>
        <button type="button" class="bd-tool" data-add-note title="Add a note">
          <span class="bd-tool__dot" style="background:#FFA600"></span> Note
        </button>
        <button type="button" class="bd-tool" data-add-photo title="Add images">
          Add images
        </button>
        <input type="file" accept="image/*" multiple hidden data-file-input />
        <button type="button" class="bd-tool" data-fit title="Fit the board to view, or press F">Fit</button>
        <button type="button" class="bd-tool bd-tool--share" data-share>Copy link</button>
      </div>
    </header>

    <!-- Studio wall behind everything: a bowed grid of CHACE work that drifts
         and crossfades. Deliberately faint, and it gets fainter still once the
         client has put something on the board. -->
    <div class="bd-wall" data-wall aria-hidden="true">
      <div class="bd-wall__inner" data-wall-inner></div>
    </div>

    <!-- Slide-out tray of studio frames. Drag one onto the board, or tap to
         drop it in the middle. -->
    <aside class="bd-drawer" data-drawer aria-hidden="true">
      <div class="bd-drawer__head">
        <span class="bd-drawer__title">Images</span>
        <button type="button" class="bd-drawer__close" data-drawer-close aria-label="Close portfolio">&times;</button>
      </div>

      {STOCK.length > 0 && (
        <div class="bd-tabs">
          <button type="button" class="bd-tab is-active" data-tab="chace">CHACE</button>
          {STOCK.map((name) => (
            <button type="button" class="bd-tab" data-tab={name}>
              {name.charAt(0).toUpperCase() + name.slice(1)}
            </button>
          ))}
        </div>
      )}

      <div class="bd-drawer__filters" data-panel-filters="chace">
        <button type="button" class="bd-chip is-active" data-filter="all">All</button>
        {PORTFOLIO.map((c) => (
          <button type="button" class="bd-chip" data-filter={c.id}>{c.label}</button>
        ))}
      </div>

      {STOCK.length > 0 && (
        <div class="bd-stock" data-panel-filters="stock" hidden>
          <input class="bd-search" type="search" placeholder="Search photos" data-stock-search />
          <div class="bd-drawer__filters bd-drawer__filters--presets">
            {PRESETS.map((preset) => (
              <button type="button" class="bd-chip" data-preset={preset}>{preset}</button>
            ))}
          </div>
        </div>
      )}

      <div class="bd-drawer__grid" data-drawer-grid>
        {PORTFOLIO_FLAT.map((img, i) => (
          <img
            class="bd-thumb"
            src={img.src}
            alt=""
            draggable="false"
            loading="lazy"
            decoding="async"
            data-src={img.src}
            data-category={img.category}
            style={`--i:${Math.min(i, 24)}`}
          />
        ))}
      </div>

      {STOCK.length > 0 && (
        <div class="bd-drawer__grid" data-stock-grid hidden>
          <p class="bd-stock__hint">Pick a category above, or search.</p>
        </div>
      )}
    </aside>

    <!-- The board itself. Pan by dragging empty space, zoom with scroll or pinch. -->
    <div class="bd-viewport" data-viewport>
      <div class="bd-grid" data-grid></div>

      <div class="bd-world" data-world>
        {items.map((item) => (
          <div
            class:list={['bd-item', `bd-item--${item.kind}`]}
            data-id={item.id}
            data-kind={item.kind}
            data-x={item.x}
            data-y={item.y}
            data-rot={item.rotation}
            data-scale={item.scale}
            style={`--x:${item.x}px; --y:${item.y}px; --rot:${item.rotation}deg; --scale:${item.scale}; z-index:${item.z}`}
          >
            <button type="button" class="bd-item__del" data-del title="Remove">&times;</button>

            {item.kind === 'photo' && (
              <figure class="bd-photo">
                <img src={item.url} alt={item.caption ?? ''} draggable="false" />
                <figcaption
                  class="bd-photo__cap"
                  data-caption
                  data-placeholder="Add a caption"
                >{item.caption ?? ''}</figcaption>
              </figure>
            )}

            {item.kind === 'note' && (
              <div class="bd-note" style={`--note:${item.colour ?? '#FFA600'}`}>
                <div class="bd-note__body" data-caption data-placeholder="Type a note">{item.caption ?? ''}</div>
              </div>
            )}
          </div>
        ))}
      </div>

      {items.length === 0 && (
        <p class="bd-empty" data-empty>
          Drop images anywhere, paste from your clipboard, or add a note.
        </p>
      )}
    </div>

    <canvas class="bd-map" data-map width="320" height="220" title="Board overview, click to jump"></canvas>

    <div class="bd-hint" data-hint hidden></div>

    <script type="application/json" data-note-colours set:html={JSON.stringify(NOTE_COLOURS)}></script>
    <script type="application/json" data-backdrop set:html={JSON.stringify(BACKDROP)}></script>
  </div>
</Base>

<style is:global>
  /* The board is a full-bleed app surface, so the usual page shell is not
     wanted here. */
  body:has(.bd) {
    overflow: hidden;
  }
  body:has(.bd) .page {
    max-width: none;
  }
</style>

<style>
  .bd {
    position: fixed;
    inset: 0;
    background: #0a0a0a;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  /* ---- Top bar ---- */
  .bd-bar {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 30;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
    background: rgba(10, 10, 10, 0.82);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .bd-bar__left,
  .bd-bar__right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .bd-logo {
    font-size: 20px;
    letter-spacing: -1px;
    color: var(--white);
  }
  .bd-client {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--muted);
    padding-left: 12px;
    border-left: 1px solid rgba(255, 255, 255, 0.15);
  }

  .bd-tool {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding: 0 14px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 9999px;
    background: transparent;
    color: var(--white);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.15s ease;
  }
  .bd-tool:hover {
    border-color: var(--white);
  }
  .bd-tool:active {
    transform: scale(0.97);
  }
  .bd-tool--share {
    background: var(--grad-accent);
    border-color: transparent;
  }
  .bd-tool__dot {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
  }

  /* ---- Canvas ---- */
  .bd-viewport {
    position: absolute;
    inset: 60px 0 0 0;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
  }
  .bd-viewport.is-panning {
    cursor: grabbing;
  }

  /* ---- Living background ---- */
  .bd-wall {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    /* Never competes with the client's images: faint, blurred, desaturated. */
    opacity: 0.05;
    filter: blur(8px) saturate(0.3);
    transition: opacity 0.9s ease;
    perspective: 900px;
    perspective-origin: 50% 45%;
  }
  /* Once the board has content, the wall gets out of the way. */
  .bd-wall.is-dim {
    opacity: 0.02;
  }

  .bd-wall__inner {
    position: absolute;
    inset: -18%;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .bd-wall__tile {
    position: absolute;
    width: 210px;
    height: 262px;
    border-radius: 4px;
    overflow: hidden;
    background: #141414;
    /* Bowed away from the centre so the wall reads as receding. */
    transform: translate3d(var(--tx), var(--ty), var(--tz)) rotateY(var(--ry)) rotateX(var(--rx));
  }
  .bd-wall__tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.4s ease;
  }
  .bd-wall__tile img.is-shown {
    opacity: 1;
  }
  .bd-wall__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--grad-accent);
    font-family: var(--font-display);
    font-size: 34px;
    letter-spacing: -1px;
    color: rgba(255, 255, 255, 0.9);
  }

  /* Dot grid drifts slower than the items, which reads as depth. */
  .bd-grid {
    position: absolute;
    inset: -50%;
    background-image: radial-gradient(rgba(255, 255, 255, 0.09) 1px, transparent 1px);
    background-size: 26px 26px;
    pointer-events: none;
  }

  .bd-world {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    transform-origin: 0 0;
  }

  .bd-item {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%) translate(var(--x), var(--y)) rotate(var(--rot))
      scale(var(--scale));
    transition: box-shadow 0.2s ease, filter 0.2s ease;
    cursor: grab;
    will-change: transform;
  }
  .bd-item.is-lifted {
    cursor: grabbing;
    z-index: 9999 !important;
  }

  /* Enter with a spring, slight overshoot, so a drop feels physical. */
  @keyframes bd-drop-in {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) translate(var(--x), var(--y)) rotate(var(--rot))
        scale(calc(var(--scale) * 0.6));
    }
    70% {
      opacity: 1;
      transform: translate(-50%, -50%) translate(var(--x), var(--y)) rotate(var(--rot))
        scale(calc(var(--scale) * 1.06));
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) translate(var(--x), var(--y)) rotate(var(--rot))
        scale(var(--scale));
    }
  }
  .bd-item--entering {
    animation: bd-drop-in 0.42s cubic-bezier(0.22, 1.2, 0.36, 1);
  }

  .bd-item__del {
    position: absolute;
    top: -10px;
    right: -10px;
    z-index: 5;
    width: 24px;
    height: 24px;
    border-radius: 9999px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    background: #fff;
    color: #0a0a0a;
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .bd-item:hover .bd-item__del,
  .bd-item.is-selected .bd-item__del {
    opacity: 1;
    transform: scale(1);
  }

  /* ---- Photo, as a print on a table ---- */
  .bd-photo {
    margin: 0;
    padding: 12px 12px 0;
    background: #f7f4ee;
    border-radius: 3px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.45), 0 2px 6px rgba(0, 0, 0, 0.35);
    width: 260px;
  }
  .bd-item.is-lifted .bd-photo,
  .bd-item.is-lifted .bd-note {
    box-shadow: 0 26px 50px rgba(0, 0, 0, 0.55), 0 6px 14px rgba(0, 0, 0, 0.4);
  }
  .bd-photo img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 340px;
    object-fit: cover;
    background: #e6e1d8;
    pointer-events: none;
  }
  .bd-photo__cap {
    padding: 9px 2px 12px;
    min-height: 34px;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 13px;
    line-height: 18px;
    color: #2a2622;
    text-align: center;
    cursor: text;
    outline: none;
  }
  .bd-photo__cap:empty::before,
  .bd-note__body:empty::before {
    content: attr(data-placeholder);
    opacity: 0.4;
  }

  /* ---- Sticky note ---- */
  .bd-note {
    width: 200px;
    min-height: 140px;
    padding: 16px;
    background: var(--note);
    border-radius: 2px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.45);
  }
  .bd-note__body {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    line-height: 20px;
    color: #16120c;
    cursor: text;
    outline: none;
    word-break: break-word;
  }
  .bd-note[style*='#0a0a0a'] .bd-note__body,
  .bd-note[style*='#FF1909'] .bd-note__body {
    color: #fff;
  }

  /* ---- Upload placeholder ---- */
  .bd-item--pending .bd-photo {
    width: 260px;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bd-shimmer {
    width: 100%;
    height: 190px;
    border-radius: 2px;
    background: linear-gradient(100deg, #e6e1d8 30%, #f7f4ee 50%, #e6e1d8 70%);
    background-size: 200% 100%;
    animation: bd-shimmer 1.1s ease-in-out infinite;
  }
  @keyframes bd-shimmer {
    to {
      background-position: -200% 0;
    }
  }

  /* An uploading card is fully visible from the first frame; the ring only
     says that the copy on the server is still catching up. */
  .bd-item.is-uploading .bd-photo img {
    filter: saturate(0.85);
  }
  .bd-progress {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 22px;
    height: 22px;
    border-radius: 9999px;
    border: 2px solid rgba(255, 255, 255, 0.55);
    border-top-color: #ff6a00;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    animation: bd-spin 0.8s linear infinite;
  }
  @keyframes bd-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .bd-item.is-failed .bd-photo {
    box-shadow: 0 0 0 2px var(--red), 0 10px 24px rgba(0, 0, 0, 0.45);
  }
  .bd-retry {
    position: absolute;
    left: 50%;
    bottom: 44px;
    transform: translateX(-50%);
    padding: 6px 12px;
    border: 0;
    border-radius: 9999px;
    background: var(--red);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
  }

  .bd-photo {
    position: relative;
  }

  .bd-empty {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.28);
    text-align: center;
    pointer-events: none;
  }

  /* ---- Portfolio drawer ---- */
  .bd-drawer {
    position: absolute;
    top: 60px;
    bottom: 0;
    left: 0;
    z-index: 25;
    width: 320px;
    max-width: 84vw;
    display: flex;
    flex-direction: column;
    background: rgba(16, 16, 16, 0.96);
    backdrop-filter: blur(14px);
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    transform: translateX(-101%);
    /* Springy, so the tray feels like it is thrown open. */
    transition: transform 0.42s cubic-bezier(0.22, 1.2, 0.36, 1);
  }
  .bd-drawer.is-open {
    transform: translateX(0);
  }

  .bd-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 16px 10px;
  }
  .bd-drawer__title {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bd-drawer__close {
    width: 26px;
    height: 26px;
    border: 0;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--white);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
  }
  .bd-drawer__close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .bd-drawer__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0 16px 12px;
  }
  .bd-chip {
    height: 26px;
    padding: 0 11px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 9999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.65);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .bd-chip:hover {
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.4);
  }
  .bd-chip.is-active {
    background: var(--grad-accent);
    border-color: transparent;
    color: var(--white);
  }

  .bd-tabs {
    display: flex;
    gap: 4px;
    padding: 0 16px 10px;
  }
  .bd-tab {
    flex: 1;
    height: 30px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: transparent;
    color: rgba(255, 255, 255, 0.6);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    cursor: pointer;
  }
  .bd-tab.is-active {
    background: rgba(255, 255, 255, 0.12);
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .bd-stock[hidden],
  .bd-drawer__filters[hidden] {
    display: none;
  }
  .bd-search {
    width: calc(100% - 32px);
    margin: 0 16px 10px;
    height: 34px;
    padding: 0 12px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--white);
    font-family: var(--font-body);
    font-size: 13px;
    outline: none;
  }
  .bd-search:focus {
    border-color: var(--orange);
  }
  .bd-drawer__filters--presets {
    max-height: 92px;
    overflow-y: auto;
  }
  .bd-drawer__grid :global(.bd-stock__hint) {
    grid-column: 1 / -1;
    margin: 8px 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(255, 255, 255, 0.35);
  }
  .bd-drawer__grid :global(.bd-thumb__wrap) {
    position: relative;
    line-height: 0;
  }
  .bd-drawer__grid :global(.bd-credit) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 4px 6px;
    border-radius: 0 0 4px 4px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
    font-family: var(--font-mono);
    font-size: 9px;
    color: rgba(255, 255, 255, 0.85);
    opacity: 0;
    transition: opacity 0.15s ease;
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bd-drawer__grid :global(.bd-thumb__wrap:hover .bd-credit) {
    opacity: 1;
  }

  .bd-drawer__grid {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 0 16px 20px;
  }
  .bd-drawer__grid :global(.bd-thumb) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px;
    cursor: grab;
    background: #1a1a1a;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .bd-drawer__grid :global(.bd-thumb:hover) {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.5);
  }
  .bd-drawer__grid :global(.bd-thumb[hidden]) {
    display: none;
  }

  /* Stagger the frames in when the tray opens. */
  @keyframes bd-thumb-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .bd-drawer.is-open .bd-drawer__grid :global(.bd-thumb) {
    animation: bd-thumb-in 0.34s ease-out backwards;
    animation-delay: calc(var(--i) * 18ms);
  }

  /* The frame that follows the cursor between tray and board. */
  .bd-ghost {
    position: fixed;
    z-index: 60;
    width: 150px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 3px;
    padding: 7px 7px 0;
    background: #f7f4ee;
    box-shadow: 0 22px 44px rgba(0, 0, 0, 0.55);
    pointer-events: none;
    transform: translate(-50%, -50%) rotate(-3deg);
  }

  /* ---- Minimap ---- */
  .bd-map {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 28;
    width: 160px;
    height: 110px;
    border-radius: 10px;
    background: rgba(20, 20, 20, 0.86);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    cursor: pointer;
    touch-action: none;
  }
  @media (max-width: 720px) {
    .bd-map {
      width: 116px;
      height: 80px;
      right: 10px;
      bottom: 10px;
    }
  }

  .bd-hint {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 40;
    padding: 10px 18px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.95);
    color: #0a0a0a;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.6px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }
  .bd-hint[hidden] {
    display: none;
  }

  .bd-viewport.is-dropping::after {
    content: '';
    position: absolute;
    inset: 12px;
    border: 2px dashed rgba(255, 166, 0, 0.7);
    border-radius: 14px;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    /* A single still frame instead of a moving wall. */
    .bd-wall__inner {
      transition: none !important;
    }
    .bd-wall__tile img {
      transition: none;
    }
    .bd-item--entering {
      animation: none;
    }
    .bd-shimmer,
    .bd-progress {
      animation: none;
    }
    .bd-drawer {
      transition: none;
    }
    .bd-drawer.is-open .bd-thumb {
      animation: none;
    }
    .bd-drawer__grid :global(.bd-thumb:hover) {
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .bd-drawer {
      width: 280px;
    }
    .bd-tabs {
    display: flex;
    gap: 4px;
    padding: 0 16px 10px;
  }
  .bd-tab {
    flex: 1;
    height: 30px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: transparent;
    color: rgba(255, 255, 255, 0.6);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    cursor: pointer;
  }
  .bd-tab.is-active {
    background: rgba(255, 255, 255, 0.12);
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .bd-stock[hidden],
  .bd-drawer__filters[hidden] {
    display: none;
  }
  .bd-search {
    width: calc(100% - 32px);
    margin: 0 16px 10px;
    height: 34px;
    padding: 0 12px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--white);
    font-family: var(--font-body);
    font-size: 13px;
    outline: none;
  }
  .bd-search:focus {
    border-color: var(--orange);
  }
  .bd-drawer__filters--presets {
    max-height: 92px;
    overflow-y: auto;
  }
  .bd-drawer__grid :global(.bd-stock__hint) {
    grid-column: 1 / -1;
    margin: 8px 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(255, 255, 255, 0.35);
  }
  .bd-drawer__grid :global(.bd-thumb__wrap) {
    position: relative;
    line-height: 0;
  }
  .bd-drawer__grid :global(.bd-credit) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 4px 6px;
    border-radius: 0 0 4px 4px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
    font-family: var(--font-mono);
    font-size: 9px;
    color: rgba(255, 255, 255, 0.85);
    opacity: 0;
    transition: opacity 0.15s ease;
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bd-drawer__grid :global(.bd-thumb__wrap:hover .bd-credit) {
    opacity: 1;
  }

  .bd-drawer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .bd-client {
      display: none;
    }
    .bd-tool {
      padding: 0 11px;
      font-size: 10px;
    }
  }
</style>

<script>
  import { upload } from '@vercel/blob/client';

  const root = document.querySelector<HTMLElement>('.bd')!;
  const slug = root.dataset.slug!;
  const viewport = document.querySelector<HTMLElement>('[data-viewport]')!;
  const world = document.querySelector<HTMLElement>('[data-world]')!;
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const hint = document.querySelector<HTMLElement>('[data-hint]')!;
  const fileInput = document.querySelector<HTMLInputElement>('[data-file-input]')!;
  // Declared here because drawMap is hoisted and called from applyTransform,
  // which runs before the navigation section is reached.
  const map = document.querySelector<HTMLCanvasElement>('[data-map]')!;
  const mapCtx = map.getContext('2d')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const NOTE_COLOURS: string[] = JSON.parse(
    document.querySelector('[data-note-colours]')?.textContent || '[]'
  );

  // ---------- view transform ----------
  let panX = 0;
  let panY = 0;
  let zoom = 1;
  const MIN_ZOOM = 0.25;
  const MAX_ZOOM = 3;
  // applyTransform runs before the navigation section is reached, so the
  // minimap only starts redrawing once its state actually exists.
  let mapReady = false;

  function applyTransform() {
    world.style.transform = `translate(${panX}px, ${panY}px) scale(${zoom})`;
    // Grid drifts at half speed, which gives the board a sense of depth.
    grid.style.backgroundPosition = `${panX * 0.5}px ${panY * 0.5}px`;
    grid.style.backgroundSize = `${26 * zoom}px ${26 * zoom}px`;
    if (mapReady) drawMap();
  }

  // Start with the origin near the middle so the first drop is comfortable.
  panX = viewport.clientWidth / 2;
  panY = viewport.clientHeight / 2;
  applyTransform();

  /** Screen point to world coordinates. */
  function toWorld(clientX: number, clientY: number) {
    const rect = viewport.getBoundingClientRect();
    return {
      x: (clientX - rect.left - panX) / zoom,
      y: (clientY - rect.top - panY) / zoom,
    };
  }

  function showHint(message: string, ms = 2600) {
    hint.textContent = message;
    hint.hidden = false;
    window.clearTimeout((showHint as any)._t);
    (showHint as any)._t = window.setTimeout(() => (hint.hidden = true), ms);
  }

  // ---------- panning, with inertia ----------
  let panning = false;
  let panPointer = -1;
  let lastX = 0;
  let lastY = 0;
  let vx = 0;
  let vy = 0;
  let glideFrame = 0;

  viewport.addEventListener('pointerdown', (e) => {
    if ((e.target as HTMLElement).closest('.bd-item')) return;
    panning = true;
    panPointer = e.pointerId;
    lastX = e.clientX;
    lastY = e.clientY;
    vx = vy = 0;
    cancelAnimationFrame(glideFrame);
    viewport.classList.add('is-panning');
    viewport.setPointerCapture(e.pointerId);
    deselect();
  });

  viewport.addEventListener('pointermove', (e) => {
    if (!panning || e.pointerId !== panPointer) return;
    let dx = e.clientX - lastX;
    let dy = e.clientY - lastY;
    // Past the edge of the content the board pushes back, so you can feel
    // that you have gone too far rather than drifting into nothing.
    const over = overshoot();
    if (over.x && Math.sign(over.x) === -Math.sign(dx)) dx *= 0.35;
    if (over.y && Math.sign(over.y) === -Math.sign(dy)) dy *= 0.35;
    panX += dx;
    panY += dy;
    vx = dx;
    vy = dy;
    lastX = e.clientX;
    lastY = e.clientY;
    applyTransform();
  });

  function endPan() {
    if (!panning) return;
    panning = false;
    viewport.classList.remove('is-panning');
    if (reduceMotion) {
      springBack();
      return;
    }
    const glide = () => {
      vx *= 0.94;
      vy *= 0.94;
      if (Math.abs(vx) < 0.15 && Math.abs(vy) < 0.15) {
        springBack();
        return;
      }
      panX += vx;
      panY += vy;
      applyTransform();
      glideFrame = requestAnimationFrame(glide);
    };
    glideFrame = requestAnimationFrame(glide);
  }
  viewport.addEventListener('pointerup', endPan);
  viewport.addEventListener('pointercancel', endPan);

  // ---------- zoom ----------
  function zoomAt(clientX: number, clientY: number, factor: number) {
    const next = Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, zoom * factor));
    const rect = viewport.getBoundingClientRect();
    const px = clientX - rect.left;
    const py = clientY - rect.top;
    // Keep the point under the cursor fixed while scaling.
    panX = px - ((px - panX) / zoom) * next;
    panY = py - ((py - panY) / zoom) * next;
    zoom = next;
    applyTransform();
  }

  viewport.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      if (e.ctrlKey || e.metaKey) {
        zoomAt(e.clientX, e.clientY, e.deltaY < 0 ? 1.08 : 0.92);
      } else {
        // Trackpad two-finger scroll pans; that is what the gesture means.
        panX -= e.deltaX;
        panY -= e.deltaY;
        applyTransform();
      }
    },
    { passive: false }
  );

  // Pinch zoom with two pointers.
  const pinch = new Map<number, { x: number; y: number }>();
  let pinchDist = 0;
  viewport.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'touch') return;
    pinch.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pinch.size === 2) {
      panning = false;
      const [a, b] = [...pinch.values()];
      pinchDist = Math.hypot(a.x - b.x, a.y - b.y);
    }
  });
  viewport.addEventListener('pointermove', (e) => {
    if (!pinch.has(e.pointerId)) return;
    pinch.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pinch.size !== 2) return;
    const [a, b] = [...pinch.values()];
    const dist = Math.hypot(a.x - b.x, a.y - b.y);
    if (pinchDist > 0) zoomAt((a.x + b.x) / 2, (a.y + b.y) / 2, dist / pinchDist);
    pinchDist = dist;
  });
  const dropPinch = (e: PointerEvent) => {
    pinch.delete(e.pointerId);
    if (pinch.size < 2) pinchDist = 0;
  };
  viewport.addEventListener('pointerup', dropPinch);
  viewport.addEventListener('pointercancel', dropPinch);

  // ---------- saving ----------
  // Items render from local state immediately and are persisted in the
  // background, so nothing the user does ever waits on the network. Until the
  // server returns a real id the element carries a temporary one, and any
  // edits made in that window are held and flushed once the id arrives.
  const realId = new WeakMap<HTMLElement, Promise<number>>();
  const pending = new Map<HTMLElement, Record<string, unknown>>();
  const timers = new Map<HTMLElement, number>();

  function idOf(el: HTMLElement): Promise<number> {
    const known = Number(el.dataset.id);
    if (Number.isFinite(known) && known > 0) return Promise.resolve(known);
    return realId.get(el) ?? Promise.reject(new Error('item never persisted'));
  }

  function save(el: HTMLElement, patch: Record<string, unknown>) {
    pending.set(el, { ...(pending.get(el) ?? {}), ...patch });
    window.clearTimeout(timers.get(el));
    timers.set(
      el,
      window.setTimeout(async () => {
        const body = pending.get(el);
        pending.delete(el);
        try {
          const id = await idOf(el);
          const res = await fetch(`/api/board/${slug}/items/${id}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (!res.ok) throw new Error(String(res.status));
        } catch {
          showHint('Could not save that change. Check your connection.');
        }
      }, 400)
    );
  }

  /** Persist a freshly created item and attach its real id to the element. */
  function persist(el: HTMLElement, data: Record<string, unknown>): Promise<number> {
    const p = (async () => {
      const res = await fetch(`/api/board/${slug}/items`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error('create failed');
      const item = (await res.json()).item;
      el.dataset.id = String(item.id);
      return item.id as number;
    })();
    realId.set(el, p);
    return p;
  }

  // ---------- item behaviour ----------
  let topZ = Math.max(0, ...[...world.children].map((el) => Number((el as HTMLElement).style.zIndex) || 0));
  let selected: HTMLElement | null = null;

  function deselect() {
    selected?.classList.remove('is-selected');
    selected = null;
  }

  function bringToFront(el: HTMLElement) {
    topZ += 1;
    el.style.zIndex = String(topZ);
    save(el, { z: topZ });
  }

  /** A small random tilt on drop, so the board always looks hand arranged. */
  const settleRotation = () => (Math.random() * 7 - 3.5).toFixed(2);

  function wireItem(el: HTMLElement) {
    const del = el.querySelector<HTMLButtonElement>('[data-del]');
    del?.addEventListener('pointerdown', (e) => e.stopPropagation());
    del?.addEventListener('click', (e) => {
      e.stopPropagation();
      removeItem(el);
    });

    // Editable caption or note body.
    const cap = el.querySelector<HTMLElement>('[data-caption]');
    if (cap) {
      cap.addEventListener('blur', () => {
        cap.contentEditable = 'false';
        save(el, { caption: cap.textContent ?? '' });
      });
      cap.addEventListener('keydown', (e) => {
        e.stopPropagation();
        if (e.key === 'Escape') cap.blur();
      });
    }

    el.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).isContentEditable) return;
      e.stopPropagation();

      deselect();
      selected = el;
      el.classList.add('is-selected', 'is-lifted');
      bringToFront(el);
      el.setPointerCapture(e.pointerId);

      // Remembered so a press that never moves can open the caption for
      // editing, while a press that travels drags the whole item.
      const startTarget = e.target as HTMLElement;
      const startX = e.clientX;
      const startY = e.clientY;
      const originX = Number(el.dataset.x);
      const originY = Number(el.dataset.y);
      const baseRot = Number(el.dataset.rot);
      let moved = false;
      let lastMoveX = startX;

      const onMove = (ev: PointerEvent) => {
        const dx = (ev.clientX - startX) / zoom;
        const dy = (ev.clientY - startY) / zoom;
        if (!moved && Math.hypot(dx, dy) < 3) return;
        moved = true;

        const nx = originX + dx;
        const ny = originY + dy;
        el.dataset.x = String(nx);
        el.dataset.y = String(ny);
        el.style.setProperty('--x', `${nx}px`);
        el.style.setProperty('--y', `${ny}px`);
        drawMap();

        // Tilt slightly in the direction of travel while carried.
        if (!reduceMotion) {
          const tilt = Math.max(-8, Math.min(8, (ev.clientX - lastMoveX) * 0.6));
          el.style.setProperty('--rot', `${baseRot + tilt}deg`);
          el.style.setProperty('--scale', String(Number(el.dataset.scale) * 1.06));
        }
        lastMoveX = ev.clientX;
      };

      const onUp = () => {
        el.removeEventListener('pointermove', onMove);
        el.removeEventListener('pointerup', onUp);
        el.classList.remove('is-lifted');
        el.style.setProperty('--scale', el.dataset.scale!);

        if (moved) {
          const rot = settleRotation();
          el.dataset.rot = rot;
          el.style.setProperty('--rot', `${rot}deg`);
          save(el, {
            x: Number(el.dataset.x),
            y: Number(el.dataset.y),
            rotation: Number(rot),
          });
        } else {
          el.style.setProperty('--rot', `${baseRot}deg`);
          // A click that did not travel: edit the caption under the cursor.
          if (startTarget.closest('[data-caption]')) focusCaption(el);
        }
      };

      el.addEventListener('pointermove', onMove);
      el.addEventListener('pointerup', onUp);
    });
  }

  [...world.children].forEach((el) => wireItem(el as HTMLElement));

  async function removeItem(el: HTMLElement) {
    el.remove();
    drawMap();
    if (selected === el) selected = null;
    try {
      const id = await idOf(el);
      await fetch(`/api/board/${slug}/items/${id}`, { method: 'DELETE' });
    } catch {
      // An item that never reached the server has nothing to delete.
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Delete' && e.key !== 'Backspace') return;
    if (!selected || (e.target as HTMLElement).isContentEditable) return;
    removeItem(selected);
  });

  /** Put the caret into an item's caption or note body. */
  function focusCaption(el: HTMLElement) {
    const target = el.querySelector<HTMLElement>('[data-caption]');
    if (!target) return;
    target.contentEditable = 'true';
    target.focus();
    const range = document.createRange();
    range.selectNodeContents(target);
    range.collapse(false);
    const sel = window.getSelection();
    sel?.removeAllRanges();
    sel?.addRange(range);
  }

  // ---------- rendering new items ----------
  function renderItem(item: any, entering = true): HTMLElement {
    const el = document.createElement('div');
    el.className = `bd-item bd-item--${item.kind}${entering && !reduceMotion ? ' bd-item--entering' : ''}`;
    // A local item has no server id yet; save() waits for one before flushing.
    if (item.id != null) el.dataset.id = String(item.id);
    el.dataset.kind = item.kind;
    el.dataset.x = String(item.x);
    el.dataset.y = String(item.y);
    el.dataset.rot = String(item.rotation ?? 0);
    el.dataset.scale = String(item.scale ?? 1);
    el.style.cssText = `--x:${item.x}px; --y:${item.y}px; --rot:${item.rotation ?? 0}deg; --scale:${item.scale ?? 1}; z-index:${item.z ?? 0}`;

    const del = document.createElement('button');
    del.type = 'button';
    del.className = 'bd-item__del';
    del.dataset.del = '';
    del.innerHTML = '&times;';
    el.appendChild(del);

    if (item.kind === 'photo') {
      const fig = document.createElement('figure');
      fig.className = 'bd-photo';
      const img = document.createElement('img');
      img.src = item.url;
      img.alt = item.caption ?? '';
      img.draggable = false;
      const cap = document.createElement('figcaption');
      cap.className = 'bd-photo__cap';
      cap.dataset.caption = '';
      cap.dataset.placeholder = 'Add a caption';
      cap.textContent = item.caption ?? '';
      fig.append(img, cap);
      el.appendChild(fig);
    } else if (item.kind === 'note') {
      const note = document.createElement('div');
      note.className = 'bd-note';
      note.style.setProperty('--note', item.colour ?? '#FFA600');
      const body = document.createElement('div');
      body.className = 'bd-note__body';
      body.dataset.caption = '';
      body.dataset.placeholder = 'Type a note';
      body.textContent = item.caption ?? '';
      note.appendChild(body);
      el.appendChild(note);
    }

    world.appendChild(el);
    wireItem(el);
    document.querySelector('[data-empty]')?.remove();
    drawMap();
    return el;
  }

  // ---------- navigation ----------
  /** World-space bounding box of everything on the board. */
  function contentBounds() {
    const items = [...world.querySelectorAll<HTMLElement>('.bd-item')];
    if (!items.length) return null;
    let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
    for (const el of items) {
      const x = Number(el.dataset.x) || 0;
      const y = Number(el.dataset.y) || 0;
      const halfW = (el.offsetWidth || 260) / 2;
      const halfH = (el.offsetHeight || 220) / 2;
      minX = Math.min(minX, x - halfW);
      maxX = Math.max(maxX, x + halfW);
      minY = Math.min(minY, y - halfH);
      maxY = Math.max(maxY, y + halfH);
    }
    return { minX, minY, maxX, maxY };
  }

  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  function animateCamera(toPanX: number, toPanY: number, toZoom: number, ms = 900) {
    if (reduceMotion) {
      panX = toPanX; panY = toPanY; zoom = toZoom;
      applyTransform();
      return;
    }
    const fromX = panX, fromY = panY, fromZoom = zoom;
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / ms);
      const e = easeInOut(t);
      panX = fromX + (toPanX - fromX) * e;
      panY = fromY + (toPanY - fromY) * e;
      zoom = fromZoom + (toZoom - fromZoom) * e;
      applyTransform();
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  /** Frame everything on the board, with breathing room. */
  function fitToContent(ms = 900) {
    const b = contentBounds();
    const vw = viewport.clientWidth;
    const vh = viewport.clientHeight;
    if (!b) {
      animateCamera(vw / 2, vh / 2, 1, ms);
      return;
    }
    const pad = 120;
    const w = b.maxX - b.minX + pad * 2;
    const h = b.maxY - b.minY + pad * 2;
    const target = Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, Math.min(vw / w, vh / h, 1.4)));
    const cx = (b.minX + b.maxX) / 2;
    const cy = (b.minY + b.maxY) / 2;
    animateCamera(vw / 2 - cx * target, vh / 2 - cy * target, target, ms);
  }

  document.querySelector('[data-fit]')?.addEventListener('click', () => fitToContent());
  document.addEventListener('keydown', (e) => {
    if (e.key.toLowerCase() !== 'f') return;
    if ((e.target as HTMLElement).isContentEditable) return;
    fitToContent();
  });

  /** How far the camera centre may stray past the content before it resists. */
  function panLimits() {
    const b = contentBounds();
    const vw = viewport.clientWidth / zoom;
    const vh = viewport.clientHeight / zoom;
    // Keep at least this much of the content on screen at the extremes, so
    // the board can never be panned entirely out of sight.
    const KEEP = 160;
    const slackX = Math.max(0, vw / 2 - KEEP);
    const slackY = Math.max(0, vh / 2 - KEEP);
    if (!b) return { minX: -slackX, maxX: slackX, minY: -slackY, maxY: slackY };
    return {
      minX: b.minX - slackX,
      maxX: b.maxX + slackX,
      minY: b.minY - slackY,
      maxY: b.maxY + slackY,
    };
  }

  function viewCentre() {
    const r = viewport.getBoundingClientRect();
    return toWorld(r.left + viewport.clientWidth / 2, r.top + viewport.clientHeight / 2);
  }

  /** Distance the centre currently sits outside the allowed region. */
  function overshoot() {
    const c = viewCentre();
    const l = panLimits();
    return {
      x: c.x < l.minX ? c.x - l.minX : c.x > l.maxX ? c.x - l.maxX : 0,
      y: c.y < l.minY ? c.y - l.minY : c.y > l.maxY ? c.y - l.maxY : 0,
    };
  }

  /** Would any item be on screen if the camera centre were here? */
  function itemVisibleFrom(cx: number, cy: number) {
    const vw = viewport.clientWidth / zoom;
    const vh = viewport.clientHeight / zoom;
    const l = cx - vw / 2, r = cx + vw / 2, t = cy - vh / 2, b = cy + vh / 2;
    return [...world.querySelectorAll<HTMLElement>('.bd-item')].some((el) => {
      const x = Number(el.dataset.x) || 0;
      const y = Number(el.dataset.y) || 0;
      const hw = (el.offsetWidth || 260) / 2;
      const hh = (el.offsetHeight || 220) / 2;
      return x + hw > l && x - hw < r && y + hh > t && y - hh < b;
    });
  }

  /**
   * Ease the camera back toward the board. Clamping to the bounding box is
   * not enough on its own: pan diagonally and you can sit in an empty corner
   * of that box with nothing on screen, so if nothing would be visible we
   * pull to the nearest item instead.
   */
  function springBack() {
    const over = overshoot();
    const c = viewCentre();
    let targetX = c.x - over.x;
    let targetY = c.y - over.y;

    if (!itemVisibleFrom(targetX, targetY)) {
      const items = [...world.querySelectorAll<HTMLElement>('.bd-item')];
      if (items.length) {
        let best = items[0];
        let bestD = Infinity;
        for (const el of items) {
          const d = Math.hypot((Number(el.dataset.x) || 0) - c.x, (Number(el.dataset.y) || 0) - c.y);
          if (d < bestD) {
            bestD = d;
            best = el;
          }
        }
        targetX = Number(best.dataset.x) || 0;
        targetY = Number(best.dataset.y) || 0;
      }
    }

    if (Math.abs(targetX - c.x) < 0.5 && Math.abs(targetY - c.y) < 0.5) return;
    animateCamera(
      panX + (c.x - targetX) * zoom,
      panY + (c.y - targetY) * zoom,
      zoom,
      480
    );
  }

  // ---------- minimap ----------
  let mapFrame = 0;
  function drawMap() {
    cancelAnimationFrame(mapFrame);
    mapFrame = requestAnimationFrame(() => {
      const w = map.width;
      const h = map.height;
      mapCtx.clearRect(0, 0, w, h);

      const b = contentBounds();
      const c = viewCentre();
      const vw = viewport.clientWidth / zoom;
      const vh = viewport.clientHeight / zoom;

      // Frame both the content and where the camera currently is, so the
      // viewport rectangle is always visible even out in empty space.
      const box = b
        ? {
            minX: Math.min(b.minX, c.x - vw / 2),
            maxX: Math.max(b.maxX, c.x + vw / 2),
            minY: Math.min(b.minY, c.y - vh / 2),
            maxY: Math.max(b.maxY, c.y + vh / 2),
          }
        : { minX: c.x - vw, maxX: c.x + vw, minY: c.y - vh, maxY: c.y + vh };

      const pad = 60;
      const bw = box.maxX - box.minX + pad * 2;
      const bh = box.maxY - box.minY + pad * 2;
      const s = Math.min(w / bw, h / bh);
      const ox = (w - bw * s) / 2 - (box.minX - pad) * s;
      const oy = (h - bh * s) / 2 - (box.minY - pad) * s;
      (drawMap as any)._proj = { s, ox, oy };

      // viewport rectangle
      mapCtx.strokeStyle = 'rgba(255,255,255,0.5)';
      mapCtx.lineWidth = 2;
      mapCtx.strokeRect((c.x - vw / 2) * s + ox, (c.y - vh / 2) * s + oy, vw * s, vh * s);

      // items
      for (const el of world.querySelectorAll<HTMLElement>('.bd-item')) {
        const x = (Number(el.dataset.x) || 0) * s + ox;
        const y = (Number(el.dataset.y) || 0) * s + oy;
        mapCtx.fillStyle = el.dataset.kind === 'note' ? '#FFA600' : '#f7f4ee';
        mapCtx.beginPath();
        mapCtx.arc(x, y, 3.4, 0, Math.PI * 2);
        mapCtx.fill();
      }
    });
  }

  function mapJump(e: PointerEvent) {
    const proj = (drawMap as any)._proj;
    if (!proj) return;
    const r = map.getBoundingClientRect();
    const mx = ((e.clientX - r.left) / r.width) * map.width;
    const my = ((e.clientY - r.top) / r.height) * map.height;
    const wx = (mx - proj.ox) / proj.s;
    const wy = (my - proj.oy) / proj.s;
    panX = viewport.clientWidth / 2 - wx * zoom;
    panY = viewport.clientHeight / 2 - wy * zoom;
    applyTransform();
  }
  map.addEventListener('pointerdown', (e) => {
    e.stopPropagation();
    mapJump(e);
    try {
      map.setPointerCapture(e.pointerId);
    } catch {
      /* capture is a nicety; jumping already happened */
    }
  });
  map.addEventListener('pointermove', (e) => {
    if (e.buttons) mapJump(e);
  });

  // ---------- images ----------
  const MAX_BYTES = 15 * 1024 * 1024;
  const MAX_EDGE = 1600;

  /** Downscale and re-encode before upload so boards stay fast. */
  async function prepare(file: File): Promise<Blob> {
    const bitmap = await createImageBitmap(file).catch(() => null);
    if (!bitmap) return file;
    const ratio = Math.min(1, MAX_EDGE / Math.max(bitmap.width, bitmap.height));
    if (ratio === 1 && file.size < 900_000) return file;

    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bitmap.width * ratio);
    canvas.height = Math.round(bitmap.height * ratio);
    canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    return new Promise((resolve) =>
      canvas.toBlob((b) => resolve(b ?? file), 'image/jpeg', 0.8)
    );
  }

  /** Load a URL fully before showing it, so swapping src never flickers. */
  function preload(url: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.onload = () => resolve();
      img.onerror = reject;
      img.src = url;
    });
  }

  async function addImage(file: File, at: { x: number; y: number }) {
    if (file.size > MAX_BYTES) {
      showHint(`${file.name} is over 15MB. Try a smaller version.`);
      return;
    }

    // Render from a local object URL straight away. The card is on the board
    // at its drop point and angle before a single byte has been uploaded.
    const localUrl = URL.createObjectURL(file);
    const rotation = Number((Math.random() * 7 - 3.5).toFixed(2));
    const el = renderItem(
      { kind: 'photo', x: at.x, y: at.y, rotation, scale: 1, z: ++topZ, url: localUrl, caption: '' },
      true
    );
    el.classList.add('is-uploading');
    const ring = document.createElement('div');
    ring.className = 'bd-progress';
    el.querySelector('.bd-photo')?.appendChild(ring);

    const finish = () => {
      el.classList.remove('is-uploading');
      ring.remove();
    };

    const attempt = async (): Promise<void> => {
      el.classList.remove('is-failed');
      el.querySelector('.bd-retry')?.remove();
      try {
        const blob = await prepare(file);
        const name = file.name.replace(/\.[^.]+$/, '') || 'image';
        const result = await upload(`boards/${slug}/${name}.jpg`, blob, {
          access: 'public',
          handleUploadUrl: '/api/board/upload',
          clientPayload: slug,
        });

        // Only swap once the remote image is decoded, so there is no flash.
        await preload(result.url);
        const img = el.querySelector('img')!;
        img.src = result.url;
        URL.revokeObjectURL(localUrl);

        await persist(el, {
          kind: 'photo',
          x: Number(el.dataset.x),
          y: Number(el.dataset.y),
          rotation: Number(el.dataset.rot),
          scale: 1,
          url: result.url,
          caption: el.querySelector<HTMLElement>('[data-caption]')?.textContent ?? '',
          author: 'client',
        });
        finish();
      } catch (err) {
        console.error('[board] upload failed:', err);
        // Keep the card. Losing a client's image silently would be worse
        // than showing them it needs another go.
        finish();
        el.classList.add('is-failed');
        if (!el.querySelector('.bd-retry')) {
          const retry = document.createElement('button');
          retry.type = 'button';
          retry.className = 'bd-retry';
          retry.textContent = 'Upload failed, retry';
          retry.addEventListener('pointerdown', (e) => e.stopPropagation());
          retry.addEventListener('click', (e) => {
            e.stopPropagation();
            el.classList.add('is-uploading');
            el.querySelector('.bd-photo')?.appendChild(ring);
            attempt();
          });
          el.querySelector('.bd-photo')?.appendChild(retry);
        }
      }
    };

    attempt();
  }

  function addFiles(files: FileList | File[], at: { x: number; y: number }) {
    [...files]
      .filter((f) => f.type.startsWith('image/'))
      .forEach((file, i) => {
        // Fan multiple files out slightly rather than stacking them exactly.
        addImage(file, { x: at.x + i * 26, y: at.y + i * 18 });
      });
  }

  viewport.addEventListener('dragover', (e) => {
    e.preventDefault();
    viewport.classList.add('is-dropping');
  });
  viewport.addEventListener('dragleave', () => viewport.classList.remove('is-dropping'));
  viewport.addEventListener('drop', (e) => {
    e.preventDefault();
    viewport.classList.remove('is-dropping');
    if (!e.dataTransfer?.files.length) return;
    addFiles(e.dataTransfer.files, toWorld(e.clientX, e.clientY));
  });

  document.addEventListener('paste', (e) => {
    const files = [...(e.clipboardData?.files ?? [])];
    if (!files.length) return;
    e.preventDefault();
    addFiles(files, toWorld(window.innerWidth / 2, window.innerHeight / 2));
  });

  document.querySelector('[data-add-photo]')?.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    if (fileInput.files?.length) {
      addFiles(fileInput.files, toWorld(window.innerWidth / 2, window.innerHeight / 2));
    }
    fileInput.value = '';
  });


  // ---------- notes ----------
  let noteColour = Math.floor(Math.random() * NOTE_COLOURS.length);
  document.querySelector('[data-add-note]')?.addEventListener('click', () => {
    const colour = NOTE_COLOURS[noteColour++ % NOTE_COLOURS.length];
    const at = toWorld(window.innerWidth / 2, window.innerHeight / 2 + 30);
    const x = at.x + (Math.random() * 80 - 40);
    const y = at.y + (Math.random() * 60 - 30);
    const rotation = Number((Math.random() * 7 - 3.5).toFixed(2));

    // Appears and takes the caret immediately; the row is written behind it.
    const el = renderItem({ kind: 'note', x, y, rotation, scale: 1, z: ++topZ, colour, caption: '' }, true);
    focusCaption(el);

    persist(el, { kind: 'note', x, y, rotation, scale: 1, colour, caption: '', author: 'client' }).catch(
      () => showHint('That note could not be saved.')
    );
  });

  // ---------- portfolio drawer ----------
  const drawer = document.querySelector<HTMLElement>('[data-drawer]')!;
  const drawerToggle = document.querySelector<HTMLButtonElement>('[data-drawer-toggle]')!;

  function setDrawer(open: boolean) {
    drawer.classList.toggle('is-open', open);
    drawer.setAttribute('aria-hidden', String(!open));
    drawerToggle.setAttribute('aria-expanded', String(open));
  }
  drawerToggle.addEventListener('click', () => setDrawer(!drawer.classList.contains('is-open')));
  document.querySelector('[data-drawer-close]')?.addEventListener('click', () => setDrawer(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer.classList.contains('is-open')) setDrawer(false);
  });

  // Filter chips
  drawer.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((chip) => {
    chip.addEventListener('click', () => {
      drawer.querySelectorAll('[data-filter]').forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      const wanted = chip.dataset.filter;
      let shown = 0;
      drawer.querySelectorAll<HTMLImageElement>('.bd-thumb').forEach((thumb) => {
        const match = wanted === 'all' || thumb.dataset.category === wanted;
        thumb.hidden = !match;
        // Restagger only what is visible, so the reveal stays quick.
        if (match) thumb.style.setProperty('--i', String(Math.min(shown++, 24)));
      });
    });
  });

  /** Place a studio frame on the board at a world position. */
  function dropPortfolio(src: string, at: { x: number; y: number }) {
    const rotation = Number((Math.random() * 7 - 3.5).toFixed(2));
    const el = renderItem(
      { kind: 'photo', x: at.x, y: at.y, rotation, scale: 1, z: ++topZ, url: src, caption: '' },
      true
    );
    persist(el, {
      kind: 'photo',
      x: at.x,
      y: at.y,
      rotation,
      scale: 1,
      url: src,
      author: 'studio',
    }).catch(() => showHint('Could not add that frame.'));
  }

  // Pointer based rather than HTML5 drag, so the same gesture works with a
  // mouse, a trackpad and a finger.
  drawer.querySelectorAll<HTMLImageElement>('.bd-thumb').forEach((thumb) => {
    thumb.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      const src = thumb.dataset.src!;
      const startX = e.clientX;
      const startY = e.clientY;
      let ghost: HTMLImageElement | null = null;
      thumb.setPointerCapture(e.pointerId);

      const onMove = (ev: PointerEvent) => {
        if (!ghost && Math.hypot(ev.clientX - startX, ev.clientY - startY) > 6) {
          ghost = document.createElement('img');
          ghost.className = 'bd-ghost';
          ghost.src = src;
          document.body.appendChild(ghost);
        }
        if (ghost) {
          ghost.style.left = `${ev.clientX}px`;
          ghost.style.top = `${ev.clientY}px`;
        }
      };

      const onUp = (ev: PointerEvent) => {
        thumb.removeEventListener('pointermove', onMove);
        thumb.removeEventListener('pointerup', onUp);
        ghost?.remove();

        const overCanvas =
          ev.clientX > drawer.getBoundingClientRect().right ||
          !drawer.classList.contains('is-open');

        if (ghost && overCanvas) {
          dropPortfolio(src, toWorld(ev.clientX, ev.clientY));
        } else if (!ghost) {
          // A tap with no travel drops it into the middle of the view.
          dropPortfolio(src, toWorld(window.innerWidth / 2, window.innerHeight / 2));
        }
      };

      thumb.addEventListener('pointermove', onMove);
      thumb.addEventListener('pointerup', onUp);
    });
  });

  // On open, walk the camera to whatever is on the board rather than
  // dropping the viewer into empty space.
  mapReady = true;
  drawMap();

  /** Resolve once every image has loaded or failed, or the wait times out. */
  function imagesSettled(timeoutMs = 4000): Promise<void> {
    const pendingImgs = [...world.querySelectorAll('img')].filter((img) => !img.complete);
    if (!pendingImgs.length) return Promise.resolve();
    return Promise.race([
      Promise.all(
        pendingImgs.map(
          (img) =>
            new Promise<void>((res) => {
              img.addEventListener('load', () => res(), { once: true });
              img.addEventListener('error', () => res(), { once: true });
            })
        )
      ).then(() => undefined),
      new Promise<void>((res) => setTimeout(res, timeoutMs)),
    ]);
  }

  const boundsKey = () => {
    const b = contentBounds();
    return b ? `${Math.round(b.minX)},${Math.round(b.minY)},${Math.round(b.maxX)},${Math.round(b.maxY)}` : '';
  };

  // Any deliberate interaction cancels the opening fit, so the camera is
  // never yanked out from under someone who has started looking around.
  let userHasInteracted = false;
  const noteInteraction = () => (userHasInteracted = true);
  viewport.addEventListener('pointerdown', noteInteraction, { once: true });
  viewport.addEventListener('wheel', noteInteraction, { once: true, passive: true });

  if (world.children.length > 0) {
    (async () => {
      // Fitting before the photos report their size measures a board that is
      // the wrong shape, which is what left the camera looking at nothing.
      await imagesSettled();
      // Two frames so the browser has finished laying the new sizes out.
      await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
      if (userHasInteracted) return;

      let key = boundsKey();
      fitToContent(900);

      // A slow image can still land after the fit and change the shape of the
      // board. Re-fit once if that happens and nobody has taken over yet.
      const settle = window.setInterval(() => {
        if (userHasInteracted) {
          window.clearInterval(settle);
          return;
        }
        const next = boundsKey();
        if (next !== key) {
          key = next;
          fitToContent(500);
        }
      }, 700);
      window.setTimeout(() => window.clearInterval(settle), 6000);
    })();
  }

  // ---------- stock image tabs ----------
  const stockGrid = document.querySelector<HTMLElement>('[data-stock-grid]');
  const chaceGrid = document.querySelector<HTMLElement>('[data-drawer-grid]')!;
  const chaceFilters = document.querySelector<HTMLElement>('[data-panel-filters="chace"]')!;
  const stockPanel = document.querySelector<HTMLElement>('[data-panel-filters="stock"]');
  let provider = 'unsplash';

  function setTab(name: string) {
    const isChace = name === 'chace';
    provider = isChace ? provider : name;
    drawer.querySelectorAll<HTMLElement>('[data-tab]').forEach((t) =>
      t.classList.toggle('is-active', t.dataset.tab === name)
    );
    chaceGrid.hidden = !isChace;
    chaceFilters.hidden = !isChace;
    if (stockPanel) stockPanel.hidden = isChace;
    if (stockGrid) stockGrid.hidden = isChace;
  }
  drawer.querySelectorAll<HTMLElement>('[data-tab]').forEach((tab) => {
    tab.addEventListener('click', () => setTab(tab.dataset.tab!));
  });

  /** Drag a stock result onto the board; it is re-hosted before it is saved. */
  function wireStockThumb(wrap: HTMLElement, result: any) {
    const img = wrap.querySelector('img')!;
    img.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      const startX = e.clientX;
      const startY = e.clientY;
      let ghost: HTMLImageElement | null = null;
      img.setPointerCapture(e.pointerId);

      const onMove = (ev: PointerEvent) => {
        if (!ghost && Math.hypot(ev.clientX - startX, ev.clientY - startY) > 6) {
          ghost = document.createElement('img');
          ghost.className = 'bd-ghost';
          ghost.src = result.thumb;
          document.body.appendChild(ghost);
        }
        if (ghost) {
          ghost.style.left = `${ev.clientX}px`;
          ghost.style.top = `${ev.clientY}px`;
        }
      };
      const onUp = (ev: PointerEvent) => {
        img.removeEventListener('pointermove', onMove);
        img.removeEventListener('pointerup', onUp);
        ghost?.remove();
        const past = ev.clientX > drawer.getBoundingClientRect().right;
        const at = ghost && past
          ? toWorld(ev.clientX, ev.clientY)
          : toWorld(window.innerWidth / 2, window.innerHeight / 2);
        if (ghost && !past) return;
        addStockImage(result, at);
      };
      img.addEventListener('pointermove', onMove);
      img.addEventListener('pointerup', onUp);
    });
  }

  async function addStockImage(result: any, at: { x: number; y: number }) {
    // Show it immediately from the provider's thumbnail, exactly as an
    // upload shows immediately from its object URL.
    const rotation = Number((Math.random() * 7 - 3.5).toFixed(2));
    const el = renderItem(
      { kind: 'photo', x: at.x, y: at.y, rotation, scale: 1, z: ++topZ, url: result.thumb, caption: '' },
      true
    );
    el.classList.add('is-uploading');
    const ring = document.createElement('div');
    ring.className = 'bd-progress';
    el.querySelector('.bd-photo')?.appendChild(ring);

    try {
      const res = await fetch(`/api/board/${slug}/rehost`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: result.full }),
      });
      if (!res.ok) throw new Error('rehost failed');
      const { url } = await res.json();
      await preload(url);
      el.querySelector('img')!.src = url;
      // Show the credit straight away rather than only after a reload.
      const credit = `${result.author}, ${result.source}`;
      const cap = el.querySelector<HTMLElement>('[data-caption]');
      if (cap && !cap.textContent?.trim()) cap.textContent = credit;
      await persist(el, {
        kind: 'photo',
        x: at.x,
        y: at.y,
        rotation,
        scale: 1,
        url,
        caption: credit,
        author: 'client',
      });
    } catch {
      showHint('Could not add that image.');
      el.remove();
    } finally {
      el.classList.remove('is-uploading');
      ring.remove();
    }
  }

  let searchSeq = 0;
  async function runSearch(q: string) {
    if (!stockGrid) return;
    const seq = ++searchSeq;
    stockGrid.innerHTML = '<p class="bd-stock__hint">Searching…</p>';
    try {
      const res = await fetch(`/api/images/${provider}?q=${encodeURIComponent(q)}`);
      const data = await res.json();
      if (seq !== searchSeq) return;
      if (!data.results?.length) {
        stockGrid.innerHTML = '<p class="bd-stock__hint">Nothing found. Try another word.</p>';
        return;
      }
      stockGrid.innerHTML = '';
      data.results.forEach((r: any, i: number) => {
        const wrap = document.createElement('div');
        wrap.className = 'bd-thumb__wrap';
        wrap.style.setProperty('--i', String(Math.min(i, 24)));
        const img = document.createElement('img');
        img.className = 'bd-thumb';
        img.src = r.thumb;
        img.draggable = false;
        img.loading = 'lazy';
        const credit = document.createElement('span');
        credit.className = 'bd-credit';
        credit.textContent = `${r.author} / ${r.source}`;
        wrap.append(img, credit);
        stockGrid.appendChild(wrap);
        wireStockThumb(wrap, r);
      });
    } catch {
      if (seq === searchSeq) {
        stockGrid.innerHTML = '<p class="bd-stock__hint">Search is unavailable right now.</p>';
      }
    }
  }

  drawer.querySelectorAll<HTMLElement>('[data-preset]').forEach((chip) => {
    chip.addEventListener('click', () => {
      drawer.querySelectorAll('[data-preset]').forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      runSearch(chip.dataset.preset!);
    });
  });

  const searchBox = document.querySelector<HTMLInputElement>('[data-stock-search]');
  let searchTimer: number | undefined;
  searchBox?.addEventListener('input', () => {
    clearTimeout(searchTimer);
    const q = searchBox.value.trim();
    if (q.length < 2) return;
    searchTimer = window.setTimeout(() => runSearch(q), 400);
  });
  searchBox?.addEventListener('keydown', (e) => e.stopPropagation());

  // ---------- living background ----------
  // A bowed grid of studio work behind the board. Atmosphere only: it is
  // faint, it dims further once the client has added anything, and it stops
  // moving entirely while they are working or if they prefer reduced motion.
  (() => {
    const wall = document.querySelector<HTMLElement>('[data-wall]');
    const inner = document.querySelector<HTMLElement>('[data-wall-inner]');
    if (!wall || !inner) return;

    const sources: string[] = JSON.parse(
      document.querySelector('[data-backdrop]')?.textContent || '[]'
    );
    if (!sources.length) return;

    const COLS = 5;
    const ROWS = 3;
    const GAP_X = 250;
    const GAP_Y = 300;
    const HOLD_MIN = 8000;
    const HOLD_MAX = 12000;

    let cursor = 0;
    const nextSource = () => sources[cursor++ % sources.length];
    const tiles: { el: HTMLElement; layers: HTMLImageElement[]; front: number }[] = [];

    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const el = document.createElement('div');
        el.className = 'bd-wall__tile';

        // Curve: tiles further from the centre turn and recede, so the grid
        // bows like a wall rather than sitting flat.
        const nx = c - (COLS - 1) / 2;
        const ny = r - (ROWS - 1) / 2;
        el.style.setProperty('--tx', `${nx * GAP_X + 50}px`);
        el.style.setProperty('--ty', `${ny * GAP_Y + 40}px`);
        el.style.setProperty('--tz', `${-Math.abs(nx) * 70 - Math.abs(ny) * 40}px`);
        el.style.setProperty('--ry', `${-nx * 9}deg`);
        el.style.setProperty('--rx', `${ny * 5}deg`);

        // Occasional brand mark rather than a photograph.
        if ((r * COLS + c) % 7 === 3) {
          el.classList.add('bd-wall__mark');
          el.textContent = 'CHACE';
          inner.appendChild(el);
          continue;
        }

        const a = document.createElement('img');
        const b = document.createElement('img');
        a.src = nextSource();
        a.classList.add('is-shown');
        a.loading = 'lazy';
        b.loading = 'lazy';
        el.append(a, b);
        inner.appendChild(el);
        tiles.push({ el, layers: [a, b], front: 0 });
      }
    }

    /** Dim the wall as soon as the board has anything on it. */
    function syncDim() {
      wall.classList.toggle('is-dim', world.children.length > 0);
    }
    syncDim();
    new MutationObserver(syncDim).observe(world, { childList: true });

    if (reduceMotion) return; // a single static frame, nothing animates

    // Crossfades, staggered so the wall never pulses in unison.
    let paused = false;
    const timers: number[] = [];
    tiles.forEach((tile, i) => {
      const swap = () => {
        if (!paused && !document.hidden) {
          const back = tile.layers[1 - tile.front];
          back.src = nextSource();
          back.classList.add('is-shown');
          tile.layers[tile.front].classList.remove('is-shown');
          tile.front = 1 - tile.front;
        }
        timers.push(window.setTimeout(swap, HOLD_MIN + Math.random() * (HOLD_MAX - HOLD_MIN)));
      };
      timers.push(window.setTimeout(swap, 600 * i + Math.random() * 1200));
    });

    // Parallax at roughly a third of the canvas, and a slow drift, both on
    // transform only so this stays on the compositor.
    let drift = 0;
    let raf = 0;
    const render = () => {
      inner.style.transform = `translate3d(${panX * 0.3 + Math.sin(drift) * 14}px, ${
        panY * 0.3 + Math.cos(drift * 0.8) * 10
      }px, 0)`;
      raf = requestAnimationFrame(() => {
        drift += 0.0016;
        render();
      });
    };
    render();

    /** Never animate under an interaction. */
    function pause() {
      if (paused) return;
      paused = true;
      cancelAnimationFrame(raf);
    }
    function resume() {
      if (!paused || document.hidden) return;
      paused = false;
      render();
    }
    viewport.addEventListener('pointerdown', pause);
    window.addEventListener('pointerup', () => window.setTimeout(resume, 400));
    document.addEventListener('focusin', pause);
    document.addEventListener('focusout', () => window.setTimeout(resume, 400));
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : resume()));
  })();

  // ---------- share ----------
  document.querySelector('[data-share]')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      showHint('Board link copied.');
    } catch {
      showHint(window.location.href);
    }
  });
</script>
