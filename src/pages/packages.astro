---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Carousel from '../components/Carousel.astro';
import RateCard from '../components/RateCard.astro';
import BookingWidget from '../components/BookingWidget.astro';
import { GROUPS as groups, INCLUDED as included, ADDONS as addons } from '../data/packages';
import { getPackage } from '../config/booking';

// A card advertises two tiers; if the package offers more, point at the
// dropdown rather than silently hiding the rest.
const hasMoreOptions = (slug: string) => (getPackage(slug)?.tiers.length ?? 0) > 2;

---

<Base
  title="Photography Packages & Prices Leicester | CHACE STUDIOS"
  description="Transparent photography, wedding, event, studio hire and podcast packages at CHACE STUDIOS Leicester. Book in minutes, no account needed."
>
  <Header />

  <main class="pk">
    <!-- Hero (white, rate-card) -->
    <section class="pk-hero sec-light">
      <p class="eyebrow reveal">Packages &amp; Booking</p>
      <h1 class="display pk-hero__title reveal">
        The rate<br />
        <span class="pk-hero__grad">card.</span>
      </h1>
      <p class="pk-hero__sub reveal">
        Transparent packages across photography, video, podcast and studio hire.
        No account needed, book in minutes.
      </p>
    </section>

    <!-- Package groups -->
    {groups.map((g) => (
      <section class="pk-group sec-light" id={g.id}>
        <Carousel label={g.label}>
          {g.cards.map((c) => (
            <RateCard {...c} moreOptions={hasMoreOptions(c.slug)} />
          ))}
        </Carousel>
      </section>
    ))}

    <!-- Every booking includes -->
    <section class="pk-included sec-light">
      <div class="panel-dark pk-included__panel reveal">
        <h2 class="display pk-included__title">Every booking includes</h2>
        <ul>
          {included.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Add-ons & good to know -->
    <section class="pk-addons sec-light">
      <h2 class="display pk-addons__title reveal">Add-ons &amp; good to know</h2>
      <ul class="pk-addons__list reveal">
        {addons.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <!-- Booking widget: real availability + Stripe Checkout -->
    <BookingWidget />
  </main>

  <Footer />
</Base>

<style>
  /* The whole page body is the white rate-card surface */
  .pk {
    background: var(--white);
  }

  /* ---- Hero ---- */
  .pk-hero {
    padding-top: 110px;
    padding-bottom: 64px;
  }
  .pk-hero .eyebrow {
    margin: 0 0 36px;
  }
  .pk-hero__title {
    font-size: clamp(56px, 10vw, 120px);
    line-height: 0.95;
    letter-spacing: -0.05em;
    margin: 0 0 32px;
  }
  .pk-hero__grad {
    background: var(--grad-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .pk-hero__sub {
    font-size: 18px;
    line-height: 29px;
    color: var(--ink-60);
    max-width: 620px;
    margin: 0;
  }

  /* ---- Groups ---- */
  .pk-group {
    padding: 32px 0;
  }

  /* ---- Every booking includes ---- */
  .pk-included {
    padding-top: 40px;
    padding-bottom: 12px;
  }
  .pk-included__panel {
    padding: 36px 40px;
  }
  .pk-included__title {
    color: var(--white);
    font-size: clamp(22px, 3vw, 28px);
    letter-spacing: -0.04em;
    margin: 0 0 22px;
  }
  .pk-included__panel :global(li) {
    font-size: 14.5px;
    line-height: 23px;
  }

  /* ---- Add-ons & good to know (quieter) ---- */
  .pk-addons {
    padding-top: 40px;
    padding-bottom: 56px;
  }
  .pk-addons__title {
    font-size: 17px;
    letter-spacing: -0.02em;
    margin: 0 0 18px;
  }
  .pk-addons__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 760px;
  }
  .pk-addons__list li {
    position: relative;
    padding-left: 20px;
    font-size: 13px;
    line-height: 20px;
    color: var(--ink-50);
  }
  .pk-addons__list li::before {
    content: '»';
    position: absolute;
    left: 0;
    color: var(--ink-50);
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .pk-included__panel {
      padding: 28px 24px;
    }
  }
</style>

