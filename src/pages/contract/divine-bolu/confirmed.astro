---
// Landing page after a successful contract payment. Reached by redirect from
// Stripe, so it reads the contract by ref rather than trusting anything typed.
export const prerender = false;

import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { query } from '../../../lib/db';
import { getContract, money, longDate } from '../../../config/contracts';
import { MAPS_URL, ADDRESS, EMAIL } from '../../../data/portfolio';

const contract = getContract('divine-bolu')!;
const [day1, day2] = contract.days;

const ref = (Astro.url.searchParams.get('ref') ?? '').trim().slice(0, 40);

// The webhook may not have landed yet, so the page never depends on it: the
// contract row exists from the moment it was signed.
let signerFirstName = '';
if (ref) {
  const { rows } = await query<{ signer_name: string }>(
    `SELECT signer_name FROM contracts WHERE ref = $1 AND slug = $2`,
    [ref, contract.slug]
  );
  signerFirstName = (rows[0]?.signer_name ?? '').split(' ')[0] ?? '';
}
---

<Base
  title={`Booking confirmed | ${contract.title}`}
  description="Your wedding coverage is confirmed."
  robots="noindex, nofollow"
>
  <Header />

  <main class="cf">
    <section class="cf-hero">
      <p class="eyebrow cf-hero__eyebrow">Booking confirmed</p>
      <h1 class="display cf-hero__title">
        {signerFirstName ? `Thank you, ${signerFirstName}.` : 'Thank you.'}
      </h1>
      <p class="cf-hero__lede">
        Both dates are secured and held exclusively for you. Nothing else is needed right now.
      </p>
      {ref && <p class="cf-ref">Reference <strong>{ref}</strong></p>}
    </section>

    <section class="cf-body sec-light">
      <div class="cf-inner">
        <div class="cf-note">
          Two emails are on their way: your booking confirmation and a copy of the agreement
          you signed. Keep them for your records. If they have not arrived in a few minutes,
          check your spam folder.
        </div>

        <h2 class="cf-h2">Your dates</h2>
        <div class="cf-days">
          {contract.days.map((d, i) => (
            <div class="cf-day">
              <span class="cf-day__no">Day {i === 0 ? 'one' : 'two'}</span>
              <span class="cf-day__date">{longDate(d.date)}</span>
              <span class="cf-day__heading">{d.heading}</span>
            </div>
          ))}
        </div>

        <h2 class="cf-h2">Payment</h2>
        <div class="cf-pay">
          <div class="cf-pay__row">
            <span>Paid in full, one payment, covering both days</span>
            <strong>{money(contract.agreedTotalPence)}</strong>
          </div>
          <div class="cf-pay__row">
            <span>Balance to come</span>
            <strong>None</strong>
          </div>
        </div>

        <h2 class="cf-h2">Where we are</h2>
        <p class="cf-addr">
          CHACE STUDIOS<br />
          {ADDRESS}
        </p>
        <a class="btn btn--ink cf-btn" href={MAPS_URL} target="_blank" rel="noopener">
          Get directions
        </a>

        <h2 class="cf-h2">Any questions</h2>
        <p class="cf-contact">
          Email <a href={`mailto:${EMAIL}`}>{EMAIL}</a> and we will get back to you. If
          anything about the schedule changes, tell us as early as you can and we will work
          around it.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .cf-hero {
    background: var(--bg);
    padding: 48px max(var(--pad), var(--safe-l)) 56px max(var(--pad), var(--safe-r));
    border-bottom: 1px solid var(--line);
  }
  .cf-hero__eyebrow {
    margin: 0 0 14px;
  }
  .cf-hero__title {
    font-size: clamp(34px, 10vw, 60px);
    line-height: 1;
    letter-spacing: -2px;
    margin: 0 0 16px;
  }
  .cf-hero__lede {
    margin: 0;
    max-width: 46ch;
    font-size: 15px;
    line-height: 25px;
    color: var(--text-70);
  }
  .cf-ref {
    margin: 18px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-50);
  }
  .cf-ref strong {
    color: var(--orange);
  }

  .cf-body {
    padding-top: 36px;
    padding-bottom: 64px;
  }
  .cf-inner {
    max-width: 620px;
    margin: 0 auto;
  }

  .cf-note {
    padding: 16px 18px;
    margin-bottom: 36px;
    border-radius: 12px;
    background: rgba(255, 166, 0, 0.1);
    border-left: 3px solid var(--orange);
    font-size: 14.5px;
    line-height: 22px;
    color: var(--ink);
  }

  .cf-h2 {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 17px;
    letter-spacing: -0.3px;
    color: var(--ink);
    margin: 0 0 16px;
  }

  .cf-days {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 36px;
  }
  .cf-day {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 16px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 12px;
  }
  .cf-day__no {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--orange);
  }
  .cf-day__date {
    font-weight: 800;
    font-size: 16px;
    color: var(--ink);
  }
  .cf-day__heading {
    font-size: 14px;
    color: var(--ink-60);
  }

  .cf-pay {
    margin-bottom: 36px;
  }
  .cf-pay__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    font-size: 14.5px;
    line-height: 22px;
    color: var(--ink);
  }
  .cf-pay__row strong {
    white-space: nowrap;
  }

  .cf-addr {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 24px;
    color: var(--ink);
  }
  .cf-btn {
    display: inline-flex;
    margin-bottom: 36px;
  }
  .cf-contact {
    margin: 0;
    font-size: 14.5px;
    line-height: 23px;
    color: var(--ink-60);
  }
  .cf-contact a {
    color: var(--ink);
    text-decoration: underline;
  }

  @media (min-width: 720px) {
    .cf-hero {
      padding-top: 72px;
      padding-bottom: 80px;
    }
    .cf-body {
      padding-top: 56px;
      padding-bottom: 88px;
    }
  }
</style>
