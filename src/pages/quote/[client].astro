---
// getStaticPaths sits above the imports deliberately: Astro's compiler will
// not hoist this export past the rest of the frontmatter, and ESM hoists the
// imports it depends on regardless.
export async function getStaticPaths() {
  const quotes = await getCollection('quotes');
  return quotes.map((quote) => {
    // Fail the build rather than ship a quote pointing at a tier that no
    // longer exists in the booking config.
    if (!getTier(quote.data.packageSlug, quote.data.tierId)) {
      throw new Error(
        `Quote "${quote.id}" references unknown tier ${quote.data.packageSlug}/${quote.data.tierId}`
      );
    }
    return { params: { client: quote.id }, props: { quote } };
  });
}

import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Slideshow from '../../components/Slideshow.astro';
import BookingWidget from '../../components/BookingWidget.astro';
import { getPackage, getTier, chargeNowPence } from '../../config/booking';
import { EMAIL, INSTAGRAM } from '../../data/portfolio';

const { quote } = Astro.props;
const q = quote.data;
const { Content } = await render(quote);

// Price is read from the shared booking config, never restated here, so a
// quote can never disagree with what the booking form actually charges.
// Validated in getStaticPaths, so both are guaranteed present here.
const pkg = getPackage(q.packageSlug)!;
const tier = getTier(q.packageSlug, q.tierId)!;
const depositPence = chargeNowPence(tier);
const balancePence = tier.pricePence - depositPence;
const money = (p: number) => (p % 100 === 0 ? `£${p / 100}` : `£${(p / 100).toFixed(2)}`);

const images = Array.from(
  { length: q.imageCount },
  (_, i) => `${q.imagesDir}/${quote.id}-${String(i + 1).padStart(2, '0')}.jpg`
);
---

<Base title={q.title} description={q.sub} robots="noindex, nofollow" ogImage={images[0]}>
  <Header />

  <main class="qt">
    <!-- Dark cinematic hero -->
    <section class="qt-hero">
      <div class="qt-hero__grid">
        <div>
          <p class="eyebrow qt-eyebrow">{q.eyebrow}</p>
          <h1 class="display qt-title">{q.heading}</h1>
          <p class="qt-sub">{q.sub}</p>

          <div class="qt-quote">
            <p class="qt-quote__line">
              <span class="display qt-quote__amount">{money(tier.pricePence)}</span>
              <span class="qt-quote__label">{pkg.title}, {tier.label}</span>
            </p>
            {tier.includes && <p class="qt-quote__includes">{tier.includes}</p>}
          </div>

          <a href="#book" class="btn btn--fill qt-cta">Book and pay</a>
        </div>

        <Slideshow images={images} caption={q.imageCaption} />
      </div>
    </section>

    <!-- White rate card section -->
    <section class="qt-body sec-light">
      {q.priceNote && <p class="qt-note">{q.priceNote}</p>}

      <div class="qt-pay">
        <div class="qt-pay__row">
          <span class="qt-pay__k">Today</span>
          <span class="qt-pay__v"><strong>{money(depositPence)}</strong>, 80%, secures your date</span>
        </div>
        <div class="qt-pay__row">
          <span class="qt-pay__k">After</span>
          <span class="qt-pay__v">{money(balancePence)} due on the day of the session or immediately after</span>
        </div>
      </div>

      {q.timeline.length > 0 && (
        <div class="qt-block">
          <h2 class="display qt-h2">How the session will run</h2>
          <ol class="qt-steps">
            {q.timeline.map((step) => (
              <li class="qt-step">
                <span class="qt-step__title">{step.title}</span>
                <span class="qt-step__body">{step.body}</span>
              </li>
            ))}
          </ol>
          {q.timelineFooter && <p class="qt-block__foot">{q.timelineFooter}</p>}
        </div>
      )}

      {q.needs.length > 0 && (
        <div class="qt-block">
          <h2 class="display qt-h2">What we need from you</h2>
          <ul class="qt-checks">
            {q.needs.map((n) => (
              <li class="qt-check">
                <span class="qt-check__mark" aria-hidden="true">✓</span>
                <span>
                  <strong>{n.title}.</strong> {n.body}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {q.included.length > 0 && (
        <div class="panel-dark qt-included">
          <h2 class="display qt-included__title">Included</h2>
          <ul>
            {q.included.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      )}

      <div class="qt-prose"><Content /></div>
    </section>

    <BookingWidget
      lockedSlug={q.packageSlug}
      lockedTierId={q.tierId}
      heading="Choose your date"
      intro="Pick a date and time that suits you and pay securely: card, Apple Pay, Google Pay, Klarna, PayPal and Pay by Bank. Your slot is held for 30 minutes while you pay."
    />

    <p class="qt-foot sec-light">
      Any questions before the day, message us on
      <a href={INSTAGRAM} target="_blank" rel="noopener">Instagram</a> or email
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>{q.quoteRef ? ` quoting ${q.quoteRef}` : ''}.
    </p>
  </main>

  <Footer />
</Base>

<style>
  .qt {
    background: var(--white);
  }

  /* ---- Dark hero ---- */
  .qt-hero {
    background: var(--bg);
    padding: 72px var(--pad) 80px;
  }
  .qt-hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }
  .qt-eyebrow {
    color: var(--orange);
    margin: 0 0 20px;
  }
  .qt-title {
    font-size: clamp(38px, 6vw, 68px);
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 0 0 16px;
  }
  .qt-sub {
    font-size: 16px;
    line-height: 25px;
    color: var(--text-60);
    margin: 0 0 34px;
  }

  .qt-quote {
    padding: 22px 24px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.03);
    margin-bottom: 30px;
  }
  .qt-quote__line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
  }
  .qt-quote__amount {
    font-size: 44px;
    letter-spacing: -2px;
    background: var(--grad-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .qt-quote__label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--white);
  }
  .qt-quote__includes {
    margin: 8px 0 0;
    font-size: 13.5px;
    color: var(--text-60);
  }

  /* ---- White body ---- */
  .qt-body {
    padding-top: 64px;
    padding-bottom: 24px;
    max-width: 820px;
    margin: 0 auto;
  }

  .qt-note {
    padding: 18px 22px;
    margin: 0 0 32px;
    background: rgba(255, 166, 0, 0.1);
    border-left: 3px solid var(--orange);
    border-radius: 10px;
    font-size: 15.5px;
    line-height: 25px;
    color: var(--ink);
  }

  .qt-pay {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 48px;
  }
  .qt-pay__row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 14px 18px;
    border: 1px solid var(--line-dark);
    border-radius: 12px;
  }
  .qt-pay__k {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--ink-50);
    min-width: 62px;
  }
  .qt-pay__v {
    font-size: 15px;
    line-height: 23px;
    color: var(--ink);
  }

  .qt-block {
    margin-bottom: 48px;
  }
  .qt-h2 {
    font-size: 21px;
    letter-spacing: -0.03em;
    margin: 0 0 20px;
  }
  .qt-block__foot {
    margin: 18px 0 0;
    font-size: 14px;
    line-height: 23px;
    color: var(--ink-60);
  }

  .qt-steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .qt-step {
    counter-increment: step;
    position: relative;
    padding: 16px 0 16px 52px;
    border-bottom: 1px solid var(--line-dark);
  }
  .qt-step:last-child {
    border-bottom: 0;
  }
  .qt-step::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 15px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--grad-accent);
    color: var(--white);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
  }
  .qt-step__title {
    display: block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 15px;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .qt-step__body {
    font-size: 14.5px;
    line-height: 23px;
    color: var(--ink-60);
  }

  .qt-checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .qt-check {
    display: flex;
    gap: 12px;
    font-size: 14.5px;
    line-height: 23px;
    color: var(--ink-60);
  }
  .qt-check__mark {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--grad-accent);
    color: var(--white);
    font-size: 12px;
    font-weight: 700;
  }
  .qt-check strong {
    color: var(--ink);
  }

  .qt-included {
    padding: 30px 34px;
    margin-bottom: 8px;
  }
  .qt-included__title {
    color: var(--white);
    font-size: 19px;
    letter-spacing: -0.03em;
    margin: 0 0 18px;
  }
  .qt-included :global(li) {
    font-size: 14.5px;
    line-height: 23px;
  }

  .qt-prose :global(p) {
    font-size: 15px;
    line-height: 25px;
    color: var(--ink-60);
  }

  .qt-foot {
    padding: 0 var(--pad) 64px;
    margin: 0;
    text-align: center;
    font-size: 13.5px;
    line-height: 22px;
    color: var(--ink-50);
  }

  @media (max-width: 900px) {
    .qt-hero__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
