---
interface Price {
  amount: string;
  label: string;
}

interface Props {
  title: string;
  image: string;
  tagline?: string;
  prices: Price[];
  bullets: string[];
  /** Highlighted line rendered under the prices. */
  highlight?: string;
  /** Show the quiet "More options available at checkout" link. */
  moreOptions?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title,
  image,
  tagline,
  prices,
  bullets,
  highlight,
  moreOptions = false,
  ctaLabel = 'Book',
  ctaHref,
} = Astro.props;

// Cards never show more than their two headline tiers; the rest live in the
// Options dropdown on the booking form.
const headline = prices.slice(0, 2);
---

<article class="rcard">
  <div class="rcard__media">
    <img class="rcard__img" src={image} alt={`${title}, CHACE STUDIOS`} loading="lazy" decoding="async" />
  </div>

  <h3 class="display rcard__title">{title}</h3>

  {tagline && <p class="rcard__tagline">{tagline}</p>}

  <div class="rcard__prices">
    {headline.map((p) => (
      <p class="rcard__price">
        <span class="display rcard__amount">{p.amount}</span>
        <span class="rcard__unit">{p.label}</span>
      </p>
    ))}
  </div>

  {moreOptions && (
    <a href="#book" class="rcard__more" data-package={title}>More options available at checkout</a>
  )}

  {highlight && <p class="rcard__highlight">{highlight}</p>}

  <div class="panel-dark rcard__panel">
    <ul>
      {bullets.map((b) => (
        <li>{b}</li>
      ))}
    </ul>
  </div>

  {ctaHref ? (
    <a href={ctaHref} class="btn btn--fill rcard__btn">{ctaLabel}</a>
  ) : (
    <a href="#book" class="btn btn--fill rcard__btn" data-package={title}>{ctaLabel}</a>
  )}
</article>

<style>
  .rcard {
    width: min(340px, 82vw);
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    padding: 16px 16px 20px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .rcard:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
  }

  .rcard__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 12px;
    margin-bottom: 20px;
    background: var(--ink);
  }

  .rcard__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .rcard:hover .rcard__img {
    transform: scale(1.04);
  }

  .rcard__title {
    color: var(--ink);
    font-size: 19px;
    line-height: 25px;
    letter-spacing: -0.9px;
    margin: 0 0 10px;
  }

  .rcard__tagline {
    font-size: 13.5px;
    line-height: 21px;
    color: var(--ink-60);
    margin: 0 0 14px;
  }

  .rcard__prices {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }

  .rcard__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
  }

  .rcard__amount {
    color: var(--ink);
    font-size: 26px;
    letter-spacing: -1.3px;
    white-space: nowrap;
  }

  .rcard__unit {
    font-size: 12.5px;
    line-height: 17px;
    color: var(--ink-50);
  }

  /* Quiet brand line: signals the full menu without cluttering the card */
  .rcard__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--orange);
    border-bottom: 1px solid rgba(255, 106, 0, 0.35);
    padding-bottom: 2px;
    width: fit-content;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .rcard__more:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .rcard__highlight {
    padding: 11px 14px;
    margin: 0 0 14px;
    background: rgba(255, 166, 0, 0.1);
    border-left: 3px solid var(--orange);
    border-radius: 8px;
    font-size: 12.5px;
    line-height: 19px;
    color: var(--ink);
  }

  .rcard__panel {
    flex: 1;
    margin-bottom: 16px;
  }

  .rcard__btn {
    height: 46px;
  }
</style>
