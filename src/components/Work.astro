---
const projects = [
  { title: 'Eternal Vows', category: 'Weddings', img: '/assets/img/work-eternal-vows.png' },
  { title: 'After Dark', category: 'Events', img: '/assets/img/work-after-dark.png' },
  { title: 'Glass House', category: 'Real Estate', img: '/assets/img/work-glass-house.png' },
  { title: 'Label No.7', category: 'Brand', img: '/assets/img/work-label-no7.png' },
  { title: 'The Booth Sessions', category: 'Podcast', img: '/assets/img/work-booth-sessions.png' },
  { title: 'First Light', category: 'Weddings', img: '/assets/img/work-eternal-vows.png' },
];
---

<section class="work section">
  <div class="work__head">
    <div>
      <p class="eyebrow work__eyebrow">— Featured Work</p>
      <h2 class="display work__title">Selected Frames</h2>
    </div>
    <a href="#" class="eyebrow work__archive">View Archive ↗</a>
  </div>

  <div class="work__grid">
    {projects.map((p) => (
      <a href="#" class="card">
        <img class="card__img" src={p.img} alt={p.title} />
        <div class="card__scrim"></div>
        <div class="card__meta">
          <span class="card__category">{p.category}</span>
          <span class="card__name display">{p.title}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .work {
    padding-top: 128px;
    padding-bottom: 128px;
  }

  .work__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .work__eyebrow {
    margin: 0 0 32px;
  }

  .work__title {
    font-size: 48px;
    line-height: 48px;
    letter-spacing: -2.4px;
    margin: 0;
  }

  .work__archive {
    transition: color 0.2s ease;
  }
  .work__archive:hover {
    color: var(--white);
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .card {
    position: relative;
    aspect-ratio: 602.66 / 252.16;
    background: var(--card);
    overflow: hidden;
  }

  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.4s ease, transform 0.6s ease;
  }
  .card:hover .card__img {
    filter: grayscale(0) contrast(1);
    transform: scale(1.04);
  }

  .card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0) 50%
    );
    opacity: 0.6;
  }

  .card__meta {
    position: absolute;
    left: 24px;
    bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card__category {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    color: var(--red);
  }

  .card__name {
    font-size: 20px;
    line-height: 28px;
    letter-spacing: -1px;
  }
</style>
