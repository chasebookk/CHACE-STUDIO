---
// ---- Slideshow timings (tune these) ----
const HOLD_MS = 3000; // how long each image stays
const FADE_MS = 600; // crossfade duration

const SLIDE_COUNT = 22;
const slides = Array.from(
  { length: SLIDE_COUNT },
  (_, i) => `/assets/img/hero/hero-${String(i + 1).padStart(2, '0')}.jpg`
);
// Slide 1 is fixed so the first paint (and the LCP image) is always the same;
// the rest are shuffled client-side on each load.
const [firstSlide, ...restSlides] = slides;
---

<section class="hero" style={`--fade-ms:${FADE_MS}ms`}>
  <div class="hero__bgs">
    <!-- Layer A holds the fixed opening image; layer B is filled in by JS.
         The two alternate opacity so there is never a hard cut. -->
    <img
      class="hero__bg is-front"
      id="hero-bg-a"
      src={firstSlide}
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      decoding="async"
    />
    <img class="hero__bg" id="hero-bg-b" alt="" aria-hidden="true" decoding="async" />
  </div>
  <div class="hero__overlay"></div>

  <p class="hero__eyebrow eyebrow">Photography. Video. Podcast. Live Production.</p>

  <div class="hero__title-wrap">
    <h1 class="hero__title display">CHACE</h1>
    <span class="hero__title hero__title--red display" aria-hidden="true">CHACE</span>
  </div>

  <a href="/packages" class="hero__badge">
    <span>Book<br />a Shoot</span>
  </a>

  <p class="hero__scroll eyebrow">Scroll ↓</p>
</section>

<style>
  .hero {
    position: relative;
    height: calc(100svh - 72px);
    min-height: 560px;
    overflow: hidden;
  }

  /* Wrapper carries the dimming so the layers underneath can animate
     cleanly between opacity 0 and 1 without fighting it. */
  .hero__bgs {
    position: absolute;
    inset: 0;
    opacity: 0.35;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity var(--fade-ms, 600ms) ease-in-out;
  }
  .hero__bg.is-front {
    opacity: 1;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0.1) 50%,
      #000000 100%
    );
  }

  .hero__eyebrow {
    position: absolute;
    top: 18%;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    text-align: center;
    white-space: nowrap;
  }

  .hero__title-wrap {
    position: absolute;
    top: 52%;
    left: 50%;
    transform: translate(-50%, -50%);
    line-height: 1;
  }

  .hero__title {
    font-size: clamp(88px, 18vw, 352px);
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 0;
    white-space: nowrap;
  }

  /* Red gradient copy that fills upward as the hero scrolls past */
  .hero__title--red {
    position: absolute;
    inset: 0;
    background: var(--grad-red);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    clip-path: inset(calc((1 - var(--reveal, 0)) * 100%) 0 0 0);
  }

  .hero__badge {
    position: absolute;
    top: 52%;
    left: 50%;
    /* --bx/--by are driven by the cursor-follow script; --bs is the hover scale */
    transform: translate(-50%, -50%) translate(var(--bx, 0px), var(--by, 0px)) scale(var(--bs, 1));
    width: 112px;
    height: 112px;
    border-radius: 9999px;
    border: 1px solid var(--red);
    background: var(--grad-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 10px;
    line-height: 12.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--white);
    will-change: transform;
    z-index: 5;
    transition: filter 0.25s ease;
  }
  .hero__badge:hover {
    --bs: 1.08;
    filter: brightness(1.1);
  }

  .hero__scroll {
    position: absolute;
    bottom: 34px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    letter-spacing: 2.2px;
  }

  @media (max-width: 720px) {
    .hero__eyebrow {
      white-space: normal;
      width: 100%;
      padding: 0 var(--pad);
      font-size: 10px;
      letter-spacing: 1.6px;
    }
    /* Touch devices get no cursor-follow, so a centred orb would sit on the
       wordmark permanently. Park it below the title instead. */
    .hero__badge {
      width: 96px;
      height: 96px;
      top: auto;
      bottom: 104px;
      transform: translateX(-50%) scale(var(--bs, 1));
    }
  }

  /* No rotation at all under reduced motion — the first image simply stays. */
  @media (prefers-reduced-motion: reduce) {
    .hero__bg {
      transition: none;
    }
  }
</style>

<script define:vars={{ HOLD_MS, FADE_MS, restSlides }}>
  (() => {
    const a = document.getElementById('hero-bg-a');
    const b = document.getElementById('hero-bg-b');
    if (!a || !b) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Reduced motion: leave the fixed first image in place, rotate nothing.
    if (reduceMotion || restSlides.length === 0) return;

    // Fisher–Yates over everything except the fixed opening slide.
    const queue = restSlides.slice();
    for (let i = queue.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [queue[i], queue[j]] = [queue[j], queue[i]];
    }

    let layers = [a, b];
    let front = 0;
    let cursor = 0;
    let timer = null;
    let running = false;

    const fetchImage = (src) =>
      new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = reject;
        img.src = src;
      });

    const schedule = (delay) => {
      clearTimeout(timer);
      timer = setTimeout(advance, delay);
    };

    async function advance() {
      if (document.hidden) {
        running = false;
        return;
      }
      const src = queue[cursor];
      cursor = (cursor + 1) % queue.length;

      try {
        // Only swap once the bytes are in — otherwise the incoming layer
        // fades up empty and flashes the background through.
        await fetchImage(src);
        const back = layers[1 - front];
        back.src = src;
        if (back.decode) {
          try {
            await back.decode();
          } catch {
            /* decode is best-effort */
          }
        }
        back.classList.add('is-front');
        layers[front].classList.remove('is-front');
        front = 1 - front;
      } catch {
        /* skip a missing image and keep the show going */
      }

      // Preload the next one during this image's hold.
      fetchImage(queue[cursor]).catch(() => {});
      schedule(HOLD_MS + FADE_MS);
    }

    // Don't start until the second image is genuinely available, so the
    // first transition is a real crossfade rather than a stall.
    fetchImage(queue[0])
      .then(() => {
        running = true;
        schedule(HOLD_MS);
      })
      .catch(() => {
        /* leave the fixed first image up */
      });

    // Save battery while the tab is in the background.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        clearTimeout(timer);
        running = false;
      } else if (!running) {
        running = true;
        schedule(HOLD_MS);
      }
    });
  })();
</script>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const red = document.querySelector<HTMLElement>('.hero__title--red');

  if (hero && red) {
    const update = () => {
      const rect = hero.getBoundingClientRect();
      // Progress from 0 (hero top at viewport top) to 1 (hero fully scrolled past)
      const progress = Math.min(1, Math.max(0, -rect.top / rect.height));
      red.style.setProperty('--reveal', String(progress));
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  // Magnetic "Book a Shoot" badge — trails the cursor across the hero,
  // eases back to centre when the pointer leaves.
  const badge = document.querySelector<HTMLElement>('.hero__badge');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;

  if (hero && badge && !reduceMotion && fine) {
    let targetX = 0;
    let targetY = 0;
    let curX = 0;
    let curY = 0;

    hero.addEventListener('pointermove', (e) => {
      const rect = hero.getBoundingClientRect();
      targetX = e.clientX - (rect.left + rect.width / 2);
      targetY = e.clientY - (rect.top + rect.height / 2);
    });

    hero.addEventListener('pointerleave', () => {
      targetX = 0;
      targetY = 0;
    });

    const tick = () => {
      curX += (targetX - curX) * 0.12;
      curY += (targetY - curY) * 0.12;
      badge.style.setProperty('--bx', `${curX.toFixed(1)}px`);
      badge.style.setProperty('--by', `${curY.toFixed(1)}px`);
      requestAnimationFrame(tick);
    };
    tick();
  }
</script>
