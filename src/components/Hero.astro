---
---

<section class="hero">
  <img class="hero__bg" src="/assets/img/hero.jpg" alt="" />
  <div class="hero__overlay"></div>

  <p class="hero__eyebrow eyebrow">Photography · Video · Podcast · Leicester, UK</p>

  <div class="hero__title-wrap">
    <h1 class="hero__title display">CHACE</h1>
    <span class="hero__title hero__title--red display" aria-hidden="true">CHACE</span>
  </div>

  <a href="/packages" class="hero__badge">
    <span>Book<br />a Shoot</span>
  </a>

  <p class="hero__scroll eyebrow">Scroll ↓</p>
</section>

<style>
  .hero {
    position: relative;
    height: 1200px;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0) 50%,
      #000000 100%
    );
  }

  .hero__eyebrow {
    position: absolute;
    top: calc(50% - 192px);
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    text-align: center;
    white-space: nowrap;
  }

  .hero__title-wrap {
    position: absolute;
    top: calc(50% + 24px);
    left: 50%;
    transform: translate(-50%, -50%);
    line-height: 352px;
  }

  .hero__title {
    font-size: 352px;
    line-height: 352px;
    letter-spacing: -17.6px;
    margin: 0;
    white-space: nowrap;
  }

  /* Red gradient copy that fills upward as the hero scrolls past */
  .hero__title--red {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--red-deep) 0%, var(--red) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    clip-path: inset(calc((1 - var(--reveal, 0)) * 100%) 0 0 0);
  }

  .hero__badge {
    position: absolute;
    top: 50%;
    left: 50%;
    /* --bx/--by are driven by the cursor-follow script; --bs is the hover scale */
    transform: translate(-50%, -50%) translate(var(--bx, 0px), var(--by, 0px)) scale(var(--bs, 1));
    width: 112px;
    height: 112px;
    border-radius: 9999px;
    border: 1px solid var(--red);
    background: linear-gradient(135deg, #000000 0%, var(--red-deep) 50%, var(--red) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 10px;
    line-height: 12.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--white);
    will-change: transform;
    z-index: 5;
  }
  .hero__badge:hover {
    --bs: 1.08;
  }

  .hero__scroll {
    position: absolute;
    bottom: 42px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    letter-spacing: 2.2px;
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const red = document.querySelector<HTMLElement>('.hero__title--red');

  if (hero && red) {
    const update = () => {
      const rect = hero.getBoundingClientRect();
      // Progress from 0 (hero top at viewport top) to 1 (hero fully scrolled past)
      const progress = Math.min(1, Math.max(0, -rect.top / rect.height));
      red.style.setProperty('--reveal', String(progress));
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  // Magnetic "Book a Shoot" badge — trails the cursor across the hero,
  // eases back to centre when the pointer leaves.
  const badge = document.querySelector<HTMLElement>('.hero__badge');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;

  if (hero && badge && !reduceMotion && fine) {
    let targetX = 0;
    let targetY = 0;
    let curX = 0;
    let curY = 0;

    hero.addEventListener('pointermove', (e) => {
      const rect = hero.getBoundingClientRect();
      targetX = e.clientX - (rect.left + rect.width / 2);
      targetY = e.clientY - (rect.top + rect.height / 2);
    });

    hero.addEventListener('pointerleave', () => {
      targetX = 0;
      targetY = 0;
    });

    const tick = () => {
      curX += (targetX - curX) * 0.12;
      curY += (targetY - curY) * 0.12;
      badge.style.setProperty('--bx', `${curX.toFixed(1)}px`);
      badge.style.setProperty('--by', `${curY.toFixed(1)}px`);
      requestAnimationFrame(tick);
    };
    tick();
  }
</script>
