---
const capabilities = [
  {
    title: 'Photography',
    desc: 'Editorial, portrait, event & product imagery with cinematic grading.',
    img: '/assets/img/cap-photography.png',
  },
  {
    title: 'Video Production',
    desc: 'Concept to final cut. Cinema-grade cameras, gimbals & editing.',
    img: '/assets/img/cap-video.png',
  },
  {
    title: 'Podcast Studio',
    desc: 'Broadcast-grade booths with pro mics, mixing & live streaming.',
    img: '/assets/img/cap-podcast.png',
  },
];
---

<section class="cap section">
  <p class="eyebrow cap__eyebrow">— Capabilities</p>

  <div class="cap__grid">
    {capabilities.map((c) => (
      <a href="#" class="cap__card">
        <div class="cap__img-wrap">
          <img class="cap__img" src={c.img} alt={c.title} />
        </div>
        <div class="cap__row">
          <h3 class="display cap__title">{c.title}</h3>
          <img class="cap__arrow" src="/assets/icons/arrow-ur.svg" alt="" width="20" height="20" />
        </div>
        <p class="cap__desc">{c.desc}</p>
      </a>
    ))}
  </div>
</section>

<style>
  .cap {
    padding-top: 128px;
    padding-bottom: 128px;
  }

  .cap__eyebrow {
    margin: 0 0 48px;
  }

  .cap__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .cap__card {
    background: var(--bg);
    padding: 40px;
    display: flex;
    flex-direction: column;
    transition: background 0.3s ease;
  }
  .cap__card:hover {
    background: #050505;
  }

  .cap__img-wrap {
    aspect-ratio: 532.66 / 222.86;
    overflow: hidden;
    margin-bottom: 40px;
  }

  .cap__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.4s ease, transform 0.6s ease;
  }
  .cap__card:hover .cap__img {
    filter: grayscale(0) contrast(1);
    transform: scale(1.04);
  }

  .cap__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .cap__title {
    font-size: 24px;
    line-height: 32px;
    letter-spacing: -1.2px;
    margin: 0;
  }

  .cap__arrow {
    flex: none;
    transition: transform 0.3s ease;
  }
  .cap__card:hover .cap__arrow {
    transform: translate(3px, -3px);
  }

  .cap__desc {
    font-size: 14px;
    line-height: 20px;
    color: var(--text-50);
    margin: 0;
  }
</style>
