<section id="book" class="cta">
  <div class="cta__glow"></div>

  <div class="cta__inner">
    <h2 class="display cta__heading">
      Ready to<br />
      <span class="grad-text">shoot?</span>
    </h2>

    <p class="cta__sub">Book your session in minutes. No account needed.</p>

    <div class="cta__actions">
      <a href="/packages" class="btn btn--fill">Book a Shoot</a>
      <a href="/packages" class="btn btn--outline">Hire the Studio</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    border-top: 1px solid var(--line);
    overflow: hidden;
    padding: 0 var(--pad);
  }

  .cta__glow {
    position: absolute;
    inset: 0;
    opacity: 0.1;
    background: linear-gradient(135deg, #000000 0%, var(--red-deep) 50%, var(--red) 100%);
  }

  .cta__inner {
    position: relative;
    height: 719px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cta__heading {
    font-size: 96px;
    line-height: 96px;
    letter-spacing: -4.8px;
    margin: 0 0 34px;
  }

  .cta__sub {
    font-size: 18px;
    line-height: 28px;
    color: var(--text-50);
    margin: 0 0 40px;
  }

  .cta__actions {
    display: flex;
    gap: 16px;
  }
</style>
