<section id="book" class="cta">
  <div class="cta__glow"></div>

  <div class="cta__inner">
    <h2 class="display cta__heading reveal">
      Ready when<br />
      <span class="grad-text">you are.</span>
    </h2>

    <p class="cta__sub reveal">Book your session in minutes. No account needed.</p>

    <div class="cta__actions reveal">
      <a href="/packages#book" class="btn btn--fill">Book Now</a>
      <a href="/packages" class="btn btn--outline">See Packages</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    border-top: 1px solid var(--line);
    overflow: hidden;
    padding: 0 var(--pad);
  }

  .cta__glow {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    background: var(--grad-accent);
  }

  .cta__inner {
    position: relative;
    padding: 140px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cta__heading {
    font-size: clamp(52px, 9vw, 96px);
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 0 0 34px;
  }

  .cta__sub {
    font-size: 18px;
    line-height: 28px;
    color: var(--text-50);
    margin: 0 0 40px;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }
</style>
